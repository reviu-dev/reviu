NODE_ENV=development
BASE_URL=http://localhost:3000
AUTH_SECRET=auth-secret
DESKTOP_UPDATE_MANIFEST_URL=https://github.com/joris-gallot/reviu/releases/latest/download/desktop-update.manifest.json
WEB_DASHBOARD_URL=http://localhost:5173

# Postgres
PG_USER=user
PG_PASSWORD=password
PG_HOST=localhost
PG_PORT=5433
PG_DATABASE=app

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
GITHUB_METRICS_FLUSH_INTERVAL_MS=15000
GITHUB_METRICS_RETENTION_DAYS=30
GITHUB_RATE_LIMIT_STATE_RETENTION_DAYS=14

# GitHub OAUTH App 
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=

# Polar
POLAR_ACCESS_TOKEN=
POLAR_SUBSCRIPTION_PRODUCT_ID=
POLAR_SUCCESS_URL=http://localhost:3000/auth/subscription?checkout_id={CHECKOUT_ID}
