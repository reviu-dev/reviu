NODE_ENV=development
BASE_URL=http://localhost:3000
PORT=3000
AUTH_SECRET=auth-secret
WEB_DASHBOARD_URL=http://localhost:5173
GITHUB_CACHE_ENABLED=true

# Postgres
PG_USER=user
PG_PASSWORD=password
PG_HOST=localhost
PG_PORT=5433
PG_DATABASE=app

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=password

# Metrics
GITHUB_RATE_LIMIT_STATE_RETENTION_DAYS=14
GITHUB_METRICS_FLUSH_INTERVAL_MS=15000
GITHUB_METRICS_RETENTION_DAYS=30
CLIENT_ANALYTICS_RETENTION_DAYS=30

# GitHub OAUTH App 
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_TOKEN=

# Polar
POLAR_ACCESS_TOKEN=
POLAR_SUBSCRIPTION_MONTHLY_PRODUCT_ID=
POLAR_SUBSCRIPTION_ANNUAL_PRODUCT_ID=
POLAR_SUCCESS_URL=http://localhost:3000/auth/subscription?checkout_id={CHECKOUT_ID}
POLAR_WEBHOOK_SECRET=

# Shipit
SHIPIT_API_KEY=
SHIPIT_PROJECT_ID=
SHIPIT_API_URL=