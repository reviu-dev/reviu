{
  "name": "backend",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": "24.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "db:push": "drizzle-kit push",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "github:metrics:prune": "node dist/scripts/prune-github-metrics.js",
    "github:metrics:prune:dev": "tsx src/scripts/prune-github-metrics.ts",
    "migrate": "tsx scripts/migrate.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.9",
    "@hono/zod-validator": "^0.7.6",
    "@linear/sdk": "^80.0.0",
    "@octokit/request": "^10.0.7",
    "@polar-sh/better-auth": "^1.8.1",
    "@polar-sh/sdk": "^0.43.1",
    "better-auth": "^1.4.18",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.1",
    "es-toolkit": "^1.44.0",
    "hono": "^4.12.7",
    "ioredis": "^5.10.0",
    "knex": "^3.1.0",
    "pg": "^8.18.0",
    "pino": "^10.3.0",
    "pino-pretty": "^13.1.3",
    "semver": "^7.7.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.2.0",
    "@octokit/types": "^16.0.0",
    "@types/node": "^20.19.32",
    "@types/pg": "^8.16.0",
    "@types/semver": "^7.7.1",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.39.2",
    "tsx": "^4.21.0",
    "type-fest": "^5.4.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.7"
  }
}
