{
  "name": "backend",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "24.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "eslint . && knip",
    "lint:fix": "eslint . --fix && knip",
    "db:push": "drizzle-kit push",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "github:metrics:prune": "node dist/scripts/prune-github-metrics.js",
    "github:metrics:prune:dev": "tsx src/scripts/prune-github-metrics.ts",
    "migrate": "tsx scripts/migrate.ts",
    "knip": "knip"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1036.0",
    "@better-auth/redis-storage": "^1.6.5",
    "@hono/node-server": "^1.19.14",
    "@hono/zod-validator": "^0.7.6",
    "@octokit/request": "^10.0.8",
    "@polar-sh/better-auth": "^1.8.3",
    "@polar-sh/sdk": "^0.47.0",
    "@shipit-dev/sdk": "^0.1.2",
    "better-auth": "^1.6.5",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "es-toolkit": "^1.45.1",
    "hono": "^4.12.14",
    "ioredis": "^5.10.1",
    "knex": "^3.2.9",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "semver": "^7.7.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^8.2.0",
    "@octokit/types": "^16.0.0",
    "@types/node": "^24.12.0",
    "@types/pg": "^8.20.0",
    "@types/semver": "^7.7.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.2.1",
    "knip": "^6.5.0",
    "tsx": "^4.21.0",
    "type-fest": "^5.6.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.4"
  }
}
