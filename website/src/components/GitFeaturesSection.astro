---
import CommandIcon from "@lucide/astro/icons/command";
import GitGraphIcon from "@lucide/astro/icons/git-graph";
import ListTodoIcon from "@lucide/astro/icons/list-todo";
import TerminalIcon from "@lucide/astro/icons/terminal";
import GitMergeConflictIcon from "@lucide/astro/icons/git-merge-conflict";
import PencilLineIcon from "@lucide/astro/icons/pencil-line";
import ThemePicture from "./ThemePicture.astro";
import { themeImageSources } from "../lib/themeImage";
import gitDark from "../assets/app_screenshots/git_dark.png";
import gitLight from "../assets/app_screenshots/git_light.png";

const sectionImage = await themeImageSources(gitLight, gitDark, 3020, 1894);

const features = [
  {
    name: "Edit and stage by hunk",
    description:
      "Edit changes directly in the diff. Stage, unstage, and restore individual hunks - or whole files - as you review, in inline or split view.",
    icon: PencilLineIcon,
  },
  {
    name: "Interactive rebase, full width",
    description:
      "Reorder, squash, reword, and drop commits in a dedicated view. Clean up the agent's commits before anyone else sees them.",
    icon: ListTodoIcon,
  },
  {
    name: "Conflicts resolved in place",
    description:
      "Accept current, incoming, or both per block, walk conflicts from the keyboard, and continue the rebase or merge once clean.",
    icon: GitMergeConflictIcon,
  },
  {
    name: "History next to your changes",
    description:
      "Browse commits in the dock and open any file as it was at any commit, without leaving your working tree.",
    icon: GitGraphIcon,
  },
  {
    name: "Built-in terminal",
    description:
      "Run git, build commands, and scripts without leaving Reviu. Launches in the selected repo so the working directory is always right.",
    icon: TerminalIcon,
  },
  {
    name: "Every command in the palette",
    description:
      "Commit, amend, undo, branch, merge, rebase, stash, cherry-pick, fetch, pull, push, force push with lease - all keyboard-first.",
    icon: CommandIcon,
  },
];
---

<section
  id="features"
  class="bg-background py-24 sm:py-32"
  data-reveal-root
  data-reveal-threshold="0.3"
>
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="reviu-reveal mx-auto max-w-2xl sm:text-center">
      <h2 class="text-base/7 font-semibold text-primary">
        A real Git client underneath
      </h2>
      <p
        class="mt-2 text-4xl font-semibold tracking-tight text-pretty text-foreground sm:text-5xl sm:text-balance"
      >
        Finish the job without switching apps.
      </p>
      <p class="mt-6 text-lg/8 text-muted-foreground">
        Reviewing is half the work. Stage what's right, fix what isn't, rewrite
        history, and push - in the same window, all from the keyboard.
      </p>
    </div>
  </div>
  <div class="relative overflow-hidden pt-16">
    <div
      class="reviu-reveal mx-auto max-w-7xl px-6 lg:px-8"
      style="--reveal-delay: 150ms;"
    >
      <ThemePicture
        sources={sectionImage}
        alt="Reviu interactive rebase and conflict resolution screenshot"
        loading="lazy"
        class="mb-[-12%] rounded-sm sm:rounded-xl shadow-2xl ring-1 ring-gray-900/10 dark:ring-white/10"
      />
      <div aria-hidden="true" class="relative">
        <div
          class="absolute -inset-x-20 bottom-0 bg-linear-to-t from-background pt-[7%]"
        >
        </div>
      </div>
    </div>
  </div>
  <div class="mx-auto mt-16 max-w-7xl px-6 sm:mt-20 md:mt-24 lg:px-8">
    <dl
      class="mx-auto grid max-w-2xl grid-cols-1 gap-x-6 gap-y-10 text-base/7 text-muted-foreground sm:grid-cols-2 lg:mx-0 lg:max-w-none lg:grid-cols-3 lg:gap-x-8 lg:gap-y-16"
    >
      {
        features.map((feature, index) => {
          const Icon = feature.icon;

          return (
            <div
              class="reviu-reveal relative pl-9"
              style={`--reveal-delay: ${index * 80 + 200}ms;`}
            >
              <dt class="font-semibold text-foreground">
                <Icon
                  aria-hidden="true"
                  class="absolute top-1 left-1 size-5 text-primary"
                />
                {feature.name}
              </dt>
              <dd class="inline text-sm">{feature.description}</dd>
            </div>
          );
        })
      }
    </dl>
  </div>
</section>
