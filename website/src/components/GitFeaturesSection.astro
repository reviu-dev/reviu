---
import CommandIcon from "@lucide/astro/icons/command";
import ListTodoIcon from "@lucide/astro/icons/list-todo";
import TerminalIcon from "@lucide/astro/icons/terminal";
import GitMergeConflictIcon from "@lucide/astro/icons/git-merge-conflict";
import PencilLineIcon from "@lucide/astro/icons/pencil-line";
import RotateCcwIcon from "@lucide/astro/icons/rotate-ccw";
import ThemePicture from "./ThemePicture.astro";
import { themeImageSources } from "../lib/themeImage";
import gitDark from "../assets/app_screenshots/git_dark.png";
import gitLight from "../assets/app_screenshots/git_light.png";

const sectionImage = await themeImageSources(gitLight, gitDark, 3020, 1834);

const workflow = [
  {
    title: "Shape the diff",
    description:
      "Stage the hunks you trust, unstage another pass, and restore the rest.",
    icon: PencilLineIcon,
    commands: ["stage hunk", "unstage", "restore"],
  },
  {
    title: "Clean the branch",
    description:
      "Squash, fixup, drop, and reorder commits before the PR exists.",
    icon: ListTodoIcon,
    commands: ["pick", "squash", "fixup", "drop"],
  },
  {
    title: "Recover messy states",
    description:
      "Resolve conflicts, continue rebases, stash work, cherry-pick, and undo mistakes.",
    icon: GitMergeConflictIcon,
    commands: ["conflicts", "stash", "cherry-pick"],
  },
];

const dockItems = [
  ["Changes", "12 files", "text-primary"],
  ["History", "148 commits", "text-muted-foreground"],
  ["Terminal", "pnpm test", "text-emerald-500"],
  ["Review", "3 comments", "text-amber-500"],
];

const paletteCommands = [
  "Commit",
  "Amend commit",
  "Push",
  "Force push with lease",
  "Interactive rebase",
  "Pop stash",
];
---

<section
  id="features"
  class="relative isolate overflow-hidden py-24 sm:py-32"
  data-reveal-root
  data-reveal-threshold="0.25"
>
  <div
    class="absolute inset-x-0 top-0 -z-10 h-px bg-linear-to-r from-transparent via-border to-transparent"
    aria-hidden="true"
  >
  </div>
  <div
    class="absolute top-32 left-0 -z-10 h-96 w-96 rounded-full bg-cyan-400/10 blur-3xl dark:bg-cyan-400/15"
    aria-hidden="true"
  >
  </div>

  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="grid gap-10 lg:grid-cols-[0.95fr_0.9fr] lg:items-end">
      <div class="reviu-reveal max-w-3xl">
        <p class="text-base/7 font-semibold text-primary">
          Real Git underneath
        </p>
        <h2
          class="mt-2 text-4xl font-semibold tracking-tight text-pretty text-foreground sm:text-6xl"
        >
          The agent writes. You own the branch.
        </h2>
      </div>
      <p
        class="reviu-reveal text-lg/8 text-muted-foreground lg:pb-2"
        style="--reveal-delay: 120ms;"
      >
        Agent work only matters when it becomes a clean commit. Reviu keeps Git
        close to the diff, so review decisions become staged hunks, rewritten
        history, and a branch you can push with confidence.
      </p>
    </div>

    <div class="mt-12 grid gap-5 lg:grid-cols-[1.22fr_0.78fr]">
      <div
        class="reviu-reveal relative lg:-ml-20 xl:-ml-32"
        style="--reveal-delay: 200ms;"
      >
        <div class="rounded-[2rem] border border-border bg-background/75 p-2 shadow-2xl shadow-primary/10 backdrop-blur dark:bg-white/[0.04] dark:shadow-black/30">
          <div class="aspect-[3020/1834] overflow-hidden rounded-[1.35rem] ring-1 ring-gray-900/10 dark:ring-white/10">
            <ThemePicture
              sources={sectionImage}
              alt="Reviu interactive rebase, hunk staging, conflicts, and Git history screenshot"
              loading="lazy"
              class="h-full w-full object-cover object-top"
            />
          </div>
        </div>
      </div>

      <div class="grid gap-3">
        {
          workflow.map((item, index) => {
            const Icon = item.icon;

            return (
              <article
                class="reviu-reveal rounded-3xl border border-border bg-background p-5 shadow-sm dark:bg-gray-950/40"
                style={`--reveal-delay: ${index * 100 + 250}ms;`}
              >
                <div class="flex items-start gap-4">
                  <div class="flex size-10 shrink-0 items-center justify-center rounded-2xl bg-primary/10 text-primary ring-1 ring-primary/15">
                    <Icon class="size-4" aria-hidden="true" />
                  </div>
                  <div>
                    <h3 class="text-lg font-semibold text-foreground">
                      {item.title}
                    </h3>
                    <p class="mt-2 text-sm/6 text-muted-foreground">
                      {item.description}
                    </p>
                  </div>
                </div>
                <div class="mt-4 flex flex-wrap gap-2">
                  {item.commands.map((command) => (
                    <span class="rounded-full border border-border bg-muted/60 px-3 py-1 text-xs font-medium text-muted-foreground dark:bg-white/[0.03]">
                      {command}
                    </span>
                  ))}
                </div>
              </article>
            );
          })
        }
      </div>
    </div>

    <div class="mt-5 grid gap-5 lg:grid-cols-[0.78fr_1.22fr]">
      <div
        class="reviu-reveal rounded-3xl border border-border bg-background p-5 shadow-sm dark:bg-gray-950/40"
        style="--reveal-delay: 450ms;"
      >
        <div class="flex items-center gap-3">
          <TerminalIcon class="size-5 text-primary" aria-hidden="true" />
          <h3 class="font-semibold text-foreground">Every surface follows the checkout</h3>
        </div>
        <div class="mt-4 space-y-2">
          {
            dockItems.map((item) => (
              <div class="flex items-center justify-between rounded-2xl border border-border bg-muted/40 px-4 py-3 text-sm dark:bg-white/[0.03]">
                <span class="font-medium text-foreground">{item[0]}</span>
                <span class={`text-xs font-semibold ${item[2]}`}>{item[1]}</span>
              </div>
            ))
          }
        </div>
      </div>

      <div
        class="reviu-reveal rounded-3xl border border-border bg-background p-5 shadow-sm dark:bg-gray-950/40"
        style="--reveal-delay: 550ms;"
      >
        <div class="flex items-center gap-3">
          <CommandIcon class="size-5 text-primary" aria-hidden="true" />
          <h3 class="font-semibold text-foreground">Git from the command palette</h3>
        </div>
        <p class="mt-2 max-w-2xl text-sm/7 text-muted-foreground">
          Commit, amend, push, rebase, and stash from the same keyboard-first
          flow as the rest of the app.
        </p>
        <div class="mt-4 grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
          {
            paletteCommands.map((command) => (
              <div class="flex items-center gap-2 rounded-2xl border border-border bg-muted/40 px-3 py-2 text-sm text-foreground dark:bg-white/[0.03]">
                <RotateCcwIcon class="size-3.5 text-primary" aria-hidden="true" />
                {command}
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
