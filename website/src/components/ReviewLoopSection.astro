---
import BellIcon from "@lucide/astro/icons/bell";
import CircleCheckIcon from "@lucide/astro/icons/circle-check";
import GitBranchIcon from "@lucide/astro/icons/git-branch";
import GitGraphIcon from "@lucide/astro/icons/git-graph";
import GitPullRequestIcon from "@lucide/astro/icons/git-pull-request";
import MessageCircleReplyIcon from "@lucide/astro/icons/message-circle-reply";
import RotateCcwIcon from "@lucide/astro/icons/rotate-ccw";
import SparklesIcon from "@lucide/astro/icons/sparkles";
import { comparisons, getComparisonUrl } from "../lib/comparisons";

const loopSteps = [
  {
    title: "Agent writes",
    description: "Starts in its own branch or worktree.",
    icon: SparklesIcon,
  },
  {
    title: "You review",
    description: "Inspect the local diff before commit.",
    icon: MessageCircleReplyIcon,
  },
  {
    title: "Send fixes back",
    description: "Turn line comments into one prompt.",
    icon: RotateCcwIcon,
  },
  {
    title: "Ship cleanly",
    description: "Stage, rebase, push, and open the PR.",
    icon: GitPullRequestIcon,
  },
];

const rails = [
  {
    title: "Isolated worktree",
    description: "Parallel agent tasks stay out of your main checkout.",
    label: "Isolation",
    icon: GitBranchIcon,
  },
  {
    title: "Attention states",
    description: "See what is running, waiting, failed, or ready for review.",
    label: "Signal",
    icon: BellIcon,
  },
  {
    title: "Real Git nearby",
    description: "Turn review decisions into staged hunks and clean history.",
    label: "Git",
    icon: GitGraphIcon,
  },
  {
    title: "PR handoff",
    description: "Use GitHub once the local branch has earned it.",
    label: "GitHub",
    icon: GitPullRequestIcon,
  },
];

const reviewBatch = [
  "Fix discount order",
  "Add rounding test",
  "Rename unclear helper",
];
---

<section
  class="py-24 sm:py-32"
  data-reveal-root
  data-reveal-threshold="0.18"
>
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="reviu-reveal mx-auto max-w-3xl text-center">
      <p class="text-xs font-semibold tracking-[0.35em] text-primary uppercase">
        Agentic review
      </p>
      <h2
        class="mt-4 text-4xl font-semibold tracking-tight text-balance text-foreground sm:text-6xl"
      >
        Review agent work before it lands.
      </h2>
      <p class="mx-auto mt-6 max-w-2xl text-lg/8 text-muted-foreground">
        Inspect the diff, leave line comments, send fixes back, then stage and
        push a clean branch when the agent gets it right.
      </p>
    </div>

    <div
      class="reviu-reveal relative mt-14 overflow-hidden rounded-[2rem] border border-border bg-muted/30 p-3 shadow-2xl shadow-primary/5 dark:bg-white/[0.03] dark:shadow-black/20"
      style="--reveal-delay: 150ms;"
    >
      <div
        class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_top_left,rgba(37,99,235,0.16),transparent_24rem),radial-gradient(circle_at_bottom_right,rgba(14,165,233,0.12),transparent_28rem)] dark:bg-[radial-gradient(circle_at_top_left,rgba(37,99,235,0.24),transparent_24rem),radial-gradient(circle_at_bottom_right,rgba(14,165,233,0.14),transparent_28rem)]"
        aria-hidden="true"
      >
      </div>

      <div class="grid gap-3 lg:grid-cols-[0.62fr_1.38fr] lg:items-start">
        <aside class="rounded-3xl border border-border bg-background/80 p-5 shadow-sm backdrop-blur dark:bg-gray-950/55">
          <div class="flex items-start justify-between gap-4">
            <div>
              <p class="text-sm font-semibold text-foreground">The review loop</p>
              <p class="mt-1 text-xs text-muted-foreground">One task, one path.</p>
            </div>
            <span class="rounded-full border border-primary/20 bg-primary/10 px-2.5 py-1 text-xs font-semibold text-primary">
              before commit
            </span>
          </div>

          <ol class="mt-5 overflow-hidden rounded-2xl border border-border bg-muted/35 dark:bg-white/[0.03]">
            {
              loopSteps.map((step, index) => {
                const Icon = step.icon;

                return (
                  <li class="border-b border-border last:border-b-0">
                    <div class="grid grid-cols-[2.25rem_1fr_auto] gap-3 p-3">
                      <div class="flex size-9 items-center justify-center rounded-xl bg-primary/10 text-primary ring-1 ring-primary/15">
                        <Icon class="size-4" aria-hidden="true" />
                      </div>
                      <div class="min-w-0">
                        <h3 class="text-sm font-semibold text-foreground">
                          {step.title}
                        </h3>
                        <p class="mt-1 text-xs/5 text-muted-foreground">
                          {step.description}
                        </p>
                      </div>
                      <span class="pt-0.5 text-xs font-semibold text-muted-foreground">
                        0{index + 1}
                      </span>
                    </div>
                  </li>
                );
              })
            }
          </ol>
        </aside>

        <article class="rounded-3xl border border-border bg-background/85 p-5 shadow-sm backdrop-blur dark:bg-gray-950/55">
          <div class="flex flex-wrap items-center justify-between gap-3 border-b border-border pb-4">
            <div class="flex min-w-0 items-center gap-3">
              <div class="flex size-10 shrink-0 items-center justify-center rounded-2xl bg-primary/10 text-primary ring-1 ring-primary/15">
                <MessageCircleReplyIcon class="size-5" aria-hidden="true" />
              </div>
              <div class="min-w-0">
                <p class="font-semibold text-foreground">Local review queue</p>
                <p class="truncate text-xs text-muted-foreground">
                  feat/checkout-discounts - 3 comments selected
                </p>
              </div>
            </div>
            <div class="inline-flex items-center gap-2 rounded-full border border-border bg-muted/60 px-3 py-1 text-xs font-semibold text-muted-foreground dark:bg-white/5">
              <CircleCheckIcon class="size-3.5 text-primary" aria-hidden="true" />
              isolated worktree
            </div>
          </div>

          <div class="mt-5 grid gap-4 lg:grid-cols-[1.08fr_0.72fr]">
            <div class="space-y-3">
              <div class="overflow-hidden rounded-2xl border border-border bg-muted/50 text-xs dark:bg-white/[0.03]">
                <div class="flex items-center justify-between border-b border-border bg-background/70 px-4 py-3 dark:bg-gray-950/60">
                  <span class="font-mono text-muted-foreground">src/discounts.ts</span>
                  <span class="font-semibold text-primary">reviewing</span>
                </div>
                <div class="grid grid-cols-[2.5rem_1fr] font-mono">
                  <div class="bg-muted/70 px-2 py-2 text-right text-muted-foreground dark:bg-white/5">117</div>
                  <div class="bg-background/70 px-3 py-2 text-muted-foreground dark:bg-gray-950/50">const total = getCartTotal(cart)</div>
                  <div class="bg-muted/70 px-2 py-2 text-right text-muted-foreground dark:bg-white/5">118</div>
                  <div class="bg-background/70 px-3 py-2 text-muted-foreground dark:bg-gray-950/50">const flat = getFlatDiscounts(cart)</div>
                  <div class="bg-muted/70 px-2 py-2 text-right text-muted-foreground dark:bg-white/5">119</div>
                  <div class="bg-background/70 px-3 py-2 text-muted-foreground dark:bg-gray-950/50">const percent = getPercentDiscount(cart)</div>
                  <div class="bg-muted/70 px-2 py-2 text-right text-muted-foreground dark:bg-white/5">120</div>
                  <div class="bg-red-500/10 px-3 py-2 text-red-700 dark:text-red-300">return applyPercent(total, percent)</div>
                  <div class="bg-muted/70 px-2 py-2 text-right text-muted-foreground dark:bg-white/5">121</div>
                  <div class="bg-emerald-500/10 px-3 py-2 text-emerald-700 dark:text-emerald-300">const subtotal = applyFlatDiscounts(total, flat)</div>
                  <div class="bg-muted/70 px-2 py-2 text-right text-muted-foreground dark:bg-white/5">122</div>
                  <div class="bg-emerald-500/10 px-3 py-2 text-emerald-700 dark:text-emerald-300">return applyPercent(subtotal, percent)</div>
                </div>
                <div class="border-t border-primary/20 bg-primary/10 p-3 text-primary">
                  apply flat discounts before percentage discounts
                </div>
              </div>

            </div>

            <div class="space-y-3">
              <div class="rounded-2xl border border-border bg-muted/40 p-3 dark:bg-white/[0.03]">
                <p class="text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground">
                  Batch to agent
                </p>
                <div class="mt-3 space-y-2 text-sm">
                  {
                    reviewBatch.map((item) => (
                      <div class="rounded-xl bg-background/80 px-3 py-2 text-foreground dark:bg-gray-950/60">
                        {item}
                      </div>
                    ))
                  }
                </div>
              </div>

              <div class="rounded-2xl border border-primary/20 bg-primary/10 p-3">
                <div class="flex items-center justify-between gap-3">
                  <div>
                    <p class="font-semibold text-foreground">Send back</p>
                    <p class="mt-1 text-xs/5 text-muted-foreground">
                      File, line, and side context included.
                    </p>
                  </div>
                  <span class="inline-flex shrink-0 rounded-md bg-primary px-3 py-2 text-xs font-semibold text-white">
                    Send 3
                  </span>
                </div>
              </div>

            </div>
          </div>
        </article>
      </div>

      <div class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {
          rails.map((rail, index) => {
            const Icon = rail.icon;

            return (
              <article
                class="reviu-reveal rounded-3xl border border-border bg-background/80 p-4 shadow-sm backdrop-blur dark:bg-gray-950/55"
                style={`--reveal-delay: ${index * 90 + 350}ms;`}
              >
                <div class="flex items-start justify-between gap-4">
                  <div class="flex size-10 items-center justify-center rounded-2xl bg-primary/10 text-primary ring-1 ring-primary/15">
                    <Icon class="size-5" aria-hidden="true" />
                  </div>
                  <span class="rounded-full border border-border bg-muted/60 px-3 py-1 text-[0.65rem] font-semibold tracking-[0.18em] text-muted-foreground uppercase dark:bg-white/5">
                    {rail.label}
                  </span>
                </div>
                <h3 class="mt-5 text-lg font-semibold tracking-tight text-foreground">
                  {rail.title}
                </h3>
                <p class="mt-2 text-sm/7 text-muted-foreground">
                  {rail.description}
                </p>
              </article>
            );
          })
        }
      </div>
    </div>

    <div
      class="reviu-reveal mt-10 flex flex-col items-center justify-between gap-4 rounded-3xl border border-border bg-background p-5 shadow-sm sm:flex-row"
      style="--reveal-delay: 800ms;"
    >
      <div>
        <p class="font-semibold text-foreground">Already have Git tooling?</p>
        <p class="mt-1 text-sm text-muted-foreground">
          Keep it. Add the missing agent review layer.
        </p>
      </div>
      <div class="flex flex-wrap justify-center gap-x-4 gap-y-2 text-sm font-semibold">
        {
          comparisons.map((comparison) => (
            <a
              href={getComparisonUrl(comparison.slug)}
              class="text-primary hover:text-primary/80"
            >
              vs {comparison.name}
            </a>
          ))
        }
        <a href="/vs" class="text-muted-foreground hover:text-foreground">
          Compare all <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </div>
</section>
