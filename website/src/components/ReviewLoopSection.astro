---
import EyeIcon from "@lucide/astro/icons/eye";
import MessageCircleReplyIcon from "@lucide/astro/icons/message-circle-reply";
import SendIcon from "@lucide/astro/icons/send";
import { comparisons, getComparisonUrl } from "../lib/comparisons";

const loopCards = [
  {
    title: "Read every diff in a real editor",
    description:
      "Your agent writes the code. Reviu shows the diff in inline or split view with syntax highlighting, so you actually read what shipped instead of skimming a terminal.",
    icon: EyeIcon,
  },
  {
    title: "Comment on the lines you want changed",
    description:
      "Leave inline review comments straight on the local diff, tied to the exact lines under discussion. No account, no push required.",
    icon: MessageCircleReplyIcon,
  },
  {
    title: "Send fixes back, no copy-paste",
    description:
      "Send your comments back to Claude or Codex from the sidebar. The agent picks up the changes you asked for and iterates.",
    icon: SendIcon,
  },
];
---

<section class="py-24 sm:py-32" data-reveal-root data-reveal-threshold="0.18">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="reviu-reveal mx-auto max-w-3xl text-center">
      <h2 class="text-base/7 font-semibold text-primary">The review loop</h2>
      <p
        class="mt-2 text-4xl font-semibold tracking-tight text-balance text-foreground sm:text-5xl"
      >
        Reviu is for developers who ship code their agent wrote.
      </p>
      <p class="mt-6 text-lg/8 text-muted-foreground">
        Agent shells stop at the diff. Git clients don't know your agent
        exists. Reviu owns the whole loop: from agent diff to review comment to
        fixes sent back, all the way to a merged pull request.
      </p>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-3">
      {
        loopCards.map((card, index) => (
          <article
            class="reviu-reveal rounded-3xl border border-border bg-background p-8"
            style={`--reveal-delay: ${index * 125 + 150}ms;`}
          >
            <div class="inline-flex size-12 items-center justify-center rounded-2xl bg-primary/10 text-primary ring-1 ring-primary/15">
              <card.icon class="size-6" aria-hidden="true" />
            </div>
            <h3 class="mt-6 text-xl font-semibold text-foreground">
              {card.title}
            </h3>
            <p class="mt-4 text-sm/7 text-muted-foreground">
              {card.description}
            </p>
          </article>
        ))
      }
    </div>

    <div
      class="reviu-reveal mt-10 flex flex-col items-center justify-center gap-x-4 gap-y-3 rounded-2xl border border-border bg-muted/20 px-6 py-5 text-sm sm:flex-row sm:flex-wrap"
      style="--reveal-delay: 200ms;"
    >
      <span class="font-medium text-foreground"
        >Switching from another Git client?</span
      >
      <span class="flex flex-wrap items-center justify-center gap-x-4 gap-y-2">
        {
          comparisons.map((comparison) => (
            <a
              href={getComparisonUrl(comparison.slug)}
              class="font-semibold text-primary hover:text-primary/80"
            >
              vs {comparison.name}
            </a>
          ))
        }
        <a
          href="/vs"
          class="font-semibold text-muted-foreground hover:text-foreground"
        >
          Compare all <span aria-hidden="true">→</span>
        </a>
      </span>
    </div>
  </div>
</section>
