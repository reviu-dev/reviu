---
import CpuIcon from "@lucide/astro/icons/cpu";
import DownloadIcon from "@lucide/astro/icons/download";
import HardDriveIcon from "@lucide/astro/icons/hard-drive";
import MonitorIcon from "@lucide/astro/icons/monitor";
import ShieldCheckIcon from "@lucide/astro/icons/shield-check";
import TerminalIcon from "@lucide/astro/icons/terminal";
import Badge from "./Badge.astro";
import { desktopDownloadUrls } from "../../constants";

const linuxInstallCommand = "curl -fsSL https://reviu.dev/install.sh | sh";

const downloadPlatforms = [
  {
    id: "macos",
    title: "macOS",
    badge: "DMG",
    icon: CpuIcon,
    description: "Native app for Apple Silicon and Intel Macs.",
    downloads: [
      {
        label: "Apple Silicon",
        href: desktopDownloadUrls.macAppleSilicon,
        event: "download-macos-apple-silicon",
      },
      {
        label: "Intel",
        href: desktopDownloadUrls.macIntel,
        event: "download-macos-intel",
      },
    ],
  },
  {
    id: "linux",
    title: "Linux",
    badge: "Shell",
    icon: HardDriveIcon,
    description: "Install from the terminal and keep updates simple.",
    installCommand: linuxInstallCommand,
  },
  {
    id: "windows",
    title: "Windows",
    badge: "EXE",
    icon: MonitorIcon,
    description: "Native builds for x64 and ARM64 Windows machines.",
    downloads: [
      {
        label: "ARM64",
        href: desktopDownloadUrls.windowsArm64,
        event: "download-windows-arm64",
      },
      {
        label: "x64",
        href: desktopDownloadUrls.windowsX64,
        event: "download-windows-x64",
      },
    ],
  },
] as const;
---

<section
  id="downloads"
  class="relative isolate overflow-hidden bg-muted/30 py-24 sm:py-32 dark:bg-white/[0.02]"
  data-reveal-root
  data-reveal-threshold="0.2"
>
  <div
    class="absolute inset-x-0 top-0 -z-10 h-px bg-linear-to-r from-transparent via-border to-transparent"
    aria-hidden="true"
  >
  </div>

  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-end">
      <div class="reviu-reveal max-w-3xl">
        <p class="text-base/7 font-semibold text-primary">Downloads</p>
        <h2
          class="mt-2 text-4xl font-semibold tracking-tight text-balance text-foreground sm:text-6xl"
        >
          Install Reviu and start with a local agent session.
        </h2>
      </div>
      <div
        class="reviu-reveal rounded-3xl border border-border bg-background p-6 shadow-sm dark:bg-gray-950/40"
        style="--reveal-delay: 120ms;"
      >
        <div class="flex items-start gap-4">
          <ShieldCheckIcon class="mt-1 size-5 shrink-0 text-primary" aria-hidden="true" />
          <div>
            <p class="font-semibold text-foreground">No account required for local work</p>
            <p class="mt-2 text-sm/7 text-muted-foreground">
              Download the native app, open a repository, and run the agent CLI
              you already use. Sign in only when you want Reviu Pro's GitHub
              pull request workflow.
            </p>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-12 grid gap-6 lg:grid-cols-3">
      {
        downloadPlatforms.map((platform, index) => (
          <article
            class="reviu-reveal flex h-full flex-col rounded-[2rem] border border-border bg-background p-6 shadow-sm dark:bg-gray-950/40"
            style={`--reveal-delay: ${index * 125 + 150}ms;`}
          >
            <div class="flex items-start justify-between gap-4">
              <div class="inline-flex size-12 items-center justify-center rounded-2xl bg-primary/10 text-primary ring-1 ring-primary/15">
                <platform.icon class="size-6" aria-hidden="true" />
              </div>
              <Badge variant="primary">{platform.badge}</Badge>
            </div>

            <div class="mt-6">
              <h3 class="text-2xl font-semibold text-foreground">
                {platform.title}
              </h3>
              <p class="mt-3 text-sm/7 text-muted-foreground">
                {platform.description}
              </p>
            </div>

            <div class="mt-auto pt-8">
              {"downloads" in platform && platform.downloads.length > 0 ? (
                <div class="flex flex-col gap-3">
                  {platform.downloads.map((download) => (
                    <a
                      href={download.href}
                      data-umami-event={download.event}
                      class="reviu-hover-lift inline-flex w-full items-center justify-center gap-2 whitespace-nowrap rounded-md bg-primary px-3 py-2 text-sm/6 font-semibold text-white shadow-xs transition-colors hover:bg-primary/80 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
                    >
                      <DownloadIcon class="size-4" aria-hidden="true" />
                      Download for {download.label}
                    </a>
                  ))}
                </div>
              ) : "installCommand" in platform ? (
                <div class="rounded-2xl border border-border bg-muted/40 p-4 dark:bg-white/[0.03]">
                  <div class="flex items-center justify-between gap-3">
                    <p class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.18em] text-primary">
                      <TerminalIcon class="size-3.5" aria-hidden="true" />
                      Install
                    </p>
                    <button
                      type="button"
                      class="inline-flex shrink-0 items-center justify-center rounded-md border border-border bg-background px-2.5 py-1 text-xs font-semibold text-foreground transition-colors hover:bg-muted dark:bg-gray-950/40"
                      data-umami-event="copy-linux-install-command"
                      data-copy-command
                      data-copy-value={platform.installCommand}
                    >
                      Copy
                    </button>
                  </div>
                  <code class="mt-3 block break-all text-xs text-foreground">
                    {platform.installCommand}
                  </code>
                </div>
              ) : null}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  const copyCommandButtons = document.querySelectorAll("[data-copy-command]");

  copyCommandButtons.forEach((button) => {
    const defaultLabel = button.textContent;
    const value = button.getAttribute("data-copy-value") ?? "";

    button.addEventListener("click", async () => {
      try {
        if (!navigator.clipboard?.writeText) {
          throw new Error("Clipboard API unavailable");
        }
        await navigator.clipboard.writeText(value);

        button.textContent = "Copied";
        window.setTimeout(() => {
          button.textContent = defaultLabel;
        }, 1200);
      } catch {
        button.textContent = "Error";
        window.setTimeout(() => {
          button.textContent = defaultLabel;
        }, 1200);
      }
    });
  });
</script>
