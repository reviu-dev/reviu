---
import CheckIcon from "@lucide/astro/icons/check";
import CircleIcon from "@lucide/astro/icons/circle";
import GitBranchIcon from "@lucide/astro/icons/git-branch";
import GitPullRequestIcon from "@lucide/astro/icons/git-pull-request";
import MinusIcon from "@lucide/astro/icons/minus";
import ShieldCheckIcon from "@lucide/astro/icons/shield-check";
import SparklesIcon from "@lucide/astro/icons/sparkles";

const downloadsSectionUrl = "#downloads";

const tiers = [
  {
    name: "Free",
    id: "free",
    href: downloadsSectionUrl,
    price: "$0",
    eyebrow: "Local agent review",
    description:
      "For coding with agents on your machine, reviewing the diff, and finishing the branch with Git.",
    icon: GitBranchIcon,
    cta: "Download Reviu",
    featureGroups: [
      {
        title: "Agent sessions",
        features: [
          "Claude Code, Codex, Gemini, and ACP registry agents",
          "Parallel sessions in isolated Git worktrees",
          "Conversation, terminal, permissions, and turn receipts",
          "Checkpoints and rollback for agent turns",
        ],
      },
      {
        title: "Local Git client",
        features: [
          "Diff editor with inline and split views",
          "Inline comments sent back to the agent",
          "Hunk staging, restore, history, and stash",
          "Interactive rebase, conflicts, cherry-pick, terminal, palette",
        ],
      },
    ],
    featured: false,
  },
  {
    name: "Pro",
    id: "pro",
    href: downloadsSectionUrl,
    eyebrow: "GitHub handoff",
    monthlyPrice: "$9",
    monthlyPriceSuffix: "/month",
    annualPrice: "$79",
    annualPriceSuffix: "/year",
    savePercent: "Save 27%",
    description:
      "For developers whose local agent work ends in GitHub pull request review and merge.",
    icon: GitPullRequestIcon,
    cta: "Download & start free trial",
    featureGroups: [
      {
        title: "Everything in Free",
        features: [
          "Agent sessions, worktrees, review comments, and Git workflow",
          "No account required until you connect GitHub",
        ],
      },
      {
        title: "GitHub in Reviu",
        features: [
          "Pull requests for your branch, in the dock",
          "Create or publish a pull request from Reviu",
          "Review and submit without leaving the app",
          "Checks, merge readiness, merge methods, and inbox notifications",
        ],
      },
    ],
    featured: true,
  },
];

const comparisonRows = [
  ["Agent sessions", true, true],
  ["Parallel worktree sessions", true, true],
  ["Inline review comments to the agent", true, true],
  ["Turn receipts, checkpoints, and rollback", true, true],
  ["Diff editor and hunk staging", true, true],
  ["History, stash, conflicts, and interactive rebase", true, true],
  ["Terminal and command palette", true, true],
  ["Branch pull request in the dock", false, true],
  ["Create or publish pull requests", false, true],
  ["GitHub review comments and submit review", false, true],
  ["Checks, merge readiness, and merge actions", false, true],
  ["GitHub notifications inbox", false, true],
  ["Browser extension for pull requests", false, true],
] as const;
---

<section
  id="pricing"
  class="group/tiers relative isolate overflow-hidden py-24 sm:py-32"
  data-reveal-root
  data-reveal-threshold="0.05"
>
  <div
    class="absolute inset-x-0 top-0 -z-10 h-px bg-linear-to-r from-transparent via-border to-transparent"
    aria-hidden="true"
  >
  </div>
  <div
    class="absolute top-32 left-1/2 -z-10 h-120 w-180 -translate-x-1/2 rounded-full bg-primary/10 blur-3xl dark:bg-primary/20"
    aria-hidden="true"
  >
  </div>

  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="reviu-reveal mx-auto max-w-4xl text-center">
      <p class="text-base/7 font-semibold text-primary">Pricing</p>
      <h2
        class="mt-2 text-4xl font-semibold tracking-tight text-balance text-foreground sm:text-6xl"
      >
        Free while the work is local. Pro when GitHub joins the loop.
      </h2>
      <p
        class="mx-auto mt-6 max-w-2xl text-lg/8 text-muted-foreground"
      >
        Reviu does not meter your agent usage. Free gives you sessions, review,
        and local Git. Pro connects the same workflow to GitHub pull requests.
      </p>
    </div>

    <div class="mt-14 grid gap-6 lg:grid-cols-2">
      {
        tiers.map((tier, index) => {
          const Icon = tier.icon;

          return (
            <article
              class="reviu-reveal relative overflow-hidden rounded-[2rem] border border-border bg-background p-6 shadow-sm data-featured:border-primary/40 data-featured:shadow-2xl data-featured:shadow-primary/10 sm:p-8 dark:bg-gray-950/40"
              data-featured={tier.featured ? "true" : undefined}
              style={`--reveal-delay: ${index * 150 + 150}ms;`}
            >
              {tier.featured && (
                <div class="absolute inset-x-0 top-0 h-1 bg-linear-to-r from-primary via-cyan-400 to-primary" />
              )}
              <div class="flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-between">
                <div>
                  <div class="flex items-center gap-3">
                    <div class="flex size-12 items-center justify-center rounded-2xl bg-primary/10 text-primary ring-1 ring-primary/15">
                      <Icon class="size-5" aria-hidden="true" />
                    </div>
                    <div>
                      <p class="text-sm font-semibold text-primary">{tier.eyebrow}</p>
                      <h3 class="text-2xl font-semibold tracking-tight text-foreground">
                        {tier.name}
                      </h3>
                    </div>
                  </div>
                  <p class="mt-5 max-w-xl text-sm/7 text-muted-foreground">
                    {tier.description}
                  </p>
                </div>

                <div class="shrink-0 sm:text-right">
                  {"annualPrice" in tier ? (
                    <div>
                      <div class="flex items-end gap-1 sm:justify-end">
                        <span class="text-5xl font-semibold tracking-tight text-foreground">
                          {tier.monthlyPrice}
                        </span>
                        <span class="pb-1 text-sm font-medium text-muted-foreground">
                          {tier.monthlyPriceSuffix}
                        </span>
                      </div>
                      <div class="mt-2 flex flex-wrap gap-2 sm:justify-end">
                        <span class="rounded-full border border-border px-3 py-1 text-xs font-semibold text-muted-foreground">
                          {tier.annualPrice}{tier.annualPriceSuffix}
                        </span>
                        <span class="rounded-full bg-primary/10 px-3 py-1 text-xs font-semibold text-primary">
                          {tier.savePercent}
                        </span>
                      </div>
                      <p class="mt-2 text-xs text-muted-foreground">
                        14-day free trial. Cancel anytime.
                      </p>
                    </div>
                  ) : (
                    <div class="text-5xl font-semibold tracking-tight text-foreground">
                      {tier.price}
                    </div>
                  )}
                </div>
              </div>

              <a
                href={tier.href}
                aria-describedby={`tier-${tier.id}`}
                data-umami-event={`see-downloads-pricing-${tier.id}`}
                class:list={[
                  "reviu-hover-lift mt-8 inline-flex w-full justify-center rounded-md px-4 py-2.5 text-sm font-semibold shadow-xs transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary sm:w-auto",
                  tier.featured
                    ? "bg-primary text-white hover:bg-primary/80"
                    : "bg-foreground text-background hover:bg-foreground/85 dark:bg-white dark:text-gray-950 dark:hover:bg-white/90",
                ]}
              >
                {tier.cta}
              </a>

              <div class="mt-8 grid gap-6 sm:grid-cols-2">
                {tier.featureGroups.map((group) => (
                  <div class="rounded-3xl border border-border bg-muted/30 p-5 dark:bg-white/[0.03]">
                    <p class="font-semibold text-foreground">{group.title}</p>
                    <ul role="list" class="mt-4 space-y-3 text-sm/6 text-muted-foreground">
                      {group.features.map((feature) => (
                        <li class="flex gap-3">
                          <CheckIcon class="mt-0.5 size-4 shrink-0 text-primary" aria-hidden="true" />
                          <span>{feature}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            </article>
          );
        })
      }
    </div>

    <div
      class="reviu-reveal mx-auto mt-16 max-w-5xl"
      style="--reveal-delay: 500ms;"
    >
      <div class="grid gap-6 lg:grid-cols-[0.55fr_1fr] lg:items-start">
        <div>
          <div class="inline-flex items-center gap-2 rounded-full border border-primary/20 bg-primary/10 px-3 py-1 text-sm font-semibold text-primary">
            <ShieldCheckIcon class="size-4" aria-hidden="true" />
            What changes with Pro
          </div>
          <h3 class="mt-5 text-3xl font-semibold tracking-tight text-foreground">
            The local loop stays free. GitHub is the paid layer.
          </h3>
          <p class="mt-4 text-sm/7 text-muted-foreground">
            Free is for agent sessions and local Git. Pro is for pull requests,
            reviews, checks, merge, notifications, and the browser extension.
          </p>
        </div>

        <div class="overflow-hidden rounded-3xl border border-border bg-background shadow-sm dark:bg-gray-950/40">
          <div class="grid grid-cols-[minmax(0,1fr)_5rem_5rem] gap-3 border-b border-border bg-muted/40 px-4 py-3 text-sm font-semibold text-foreground sm:grid-cols-[minmax(0,1fr)_7rem_7rem] sm:px-6 dark:bg-white/[0.03]">
            <div>Feature</div>
            <div class="text-center">Free</div>
            <div class="text-center text-primary">Pro</div>
          </div>
          <div class="divide-y divide-border">
            {
              comparisonRows.map((row) => (
                <div class="grid grid-cols-[minmax(0,1fr)_5rem_5rem] gap-3 px-4 py-3 text-sm sm:grid-cols-[minmax(0,1fr)_7rem_7rem] sm:px-6">
                  <div class="font-medium text-foreground">{row[0]}</div>
                  {[row[1], row[2]].map((included) => (
                    <div class="flex justify-center">
                      <span
                        class:list={[
                          "inline-flex size-7 items-center justify-center rounded-full ring-1 ring-inset",
                          included
                            ? "bg-primary/10 text-primary ring-primary/15"
                            : "bg-muted text-muted-foreground ring-border dark:bg-white/[0.03]",
                        ]}
                      >
                        {included ? (
                          <CheckIcon class="size-4" aria-hidden="true" />
                        ) : (
                          <MinusIcon class="size-4" aria-hidden="true" />
                        )}
                      </span>
                    </div>
                  ))}
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>

    <div
      class="reviu-reveal mx-auto mt-10 flex max-w-3xl flex-col items-center justify-center gap-3 rounded-3xl border border-border bg-background p-5 text-center shadow-sm sm:flex-row sm:text-left dark:bg-gray-950/40"
      style="--reveal-delay: 650ms;"
    >
      <SparklesIcon class="size-5 text-primary" aria-hidden="true" />
      <p class="text-sm text-muted-foreground">
        No API keys, no Reviu token meter. Your agent runs through the CLI you
        already installed and signed into.
      </p>
      <CircleIcon class="hidden size-1.5 shrink-0 fill-current text-border sm:block" aria-hidden="true" />
      <a href="#downloads" class="shrink-0 whitespace-nowrap text-sm font-semibold text-primary hover:text-primary/80">
        Download Reviu <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>
