---
import prDark from "../assets/app_screenshots/pr_dark.png";
import prLight from "../assets/app_screenshots/pr_light.png";
import BellIcon from "@lucide/astro/icons/bell";
import CircleCheckIcon from "@lucide/astro/icons/circle-check";
import GitMergeIcon from "@lucide/astro/icons/git-merge";
import GitPullRequestCreateIcon from "@lucide/astro/icons/git-pull-request-create";
import MessageCircleReplyIcon from "@lucide/astro/icons/message-circle-reply";
import ServerCogIcon from "@lucide/astro/icons/server-cog";
import ShieldCheckIcon from "@lucide/astro/icons/shield-check";
import SmartphoneIcon from "@lucide/astro/icons/smartphone";
import ThemePicture from "./ThemePicture.astro";
import { themeImageSources } from "../lib/themeImage";

const sectionImage = await themeImageSources(prLight, prDark, 3020, 1894);

const features = [
  {
    name: "The PR follows your branch",
    description:
      "Check out a branch and Reviu finds its pull request, or helps create one from the header.",
    icon: GitPullRequestCreateIcon,
  },
  {
    name: "Review GitHub diffs locally",
    description:
      "Open PR files in the editor, comment inline, reply to threads, and submit a full review.",
    icon: MessageCircleReplyIcon,
  },
  {
    name: "Merge like GitHub would",
    description:
      "Squash, merge, or rebase with GitHub's generated title, message, bullets, and trailers.",
    icon: GitMergeIcon,
  },
];

const mergeRows = [
  ["checks", "passed", "text-emerald-500"],
  ["review", "approved", "text-emerald-500"],
  ["merge", "ready", "text-primary"],
];

const incomingItems = [
  {
    name: "Mobile access",
    icon: SmartphoneIcon,
  },
  {
    name: "Remote over SSH",
    icon: ServerCogIcon,
  },
];
---

<section
  class="relative isolate overflow-hidden bg-muted/30 py-24 sm:py-32 dark:bg-white/[0.02]"
  data-reveal-root
  data-reveal-threshold="0.25"
>
  <div
    class="absolute inset-x-0 top-0 -z-10 h-px bg-linear-to-r from-transparent via-border to-transparent"
    aria-hidden="true"
  >
  </div>
  <div
    class="absolute top-20 left-1/2 -z-10 h-120 w-180 -translate-x-1/2 rounded-full bg-primary/10 blur-3xl dark:bg-primary/20"
    aria-hidden="true"
  >
  </div>

  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="reviu-reveal mx-auto max-w-4xl text-center">
      <div class="inline-flex items-center gap-2 rounded-full border border-primary/20 bg-primary/10 px-3 py-1 text-sm font-semibold text-primary">
        <ShieldCheckIcon class="size-4" aria-hidden="true" />
        Reviu Pro
      </div>
      <h2
        class="mt-6 text-4xl font-semibold tracking-tight text-balance text-foreground sm:text-6xl"
      >
        GitHub PRs without losing local context.
      </h2>
      <p class="mx-auto mt-6 max-w-3xl text-lg/8 text-muted-foreground">
        Your branch, agent session, working tree, review threads, checks, and
        merge button live in one window. Use GitHub without turning every review
        into a browser tab hunt.
      </p>
    </div>

    <div class="mt-14 grid gap-6 lg:grid-cols-[1fr_0.36fr]">
      <div
        class="reviu-reveal relative rounded-[2rem] border border-border bg-background/75 p-2 shadow-2xl shadow-primary/10 backdrop-blur dark:bg-white/[0.04] dark:shadow-black/30"
        style="--reveal-delay: 150ms;"
      >
        <ThemePicture
          sources={sectionImage}
          alt="Reviu Pro pull request dock with review threads, checks, and merge workflow"
          loading="lazy"
          class="rounded-[1.35rem] ring-1 ring-gray-900/10 dark:ring-white/10"
        />
      </div>

      <div class="grid gap-4">
        <div
          class="reviu-reveal rounded-3xl border border-border bg-background p-5 shadow-sm dark:bg-gray-950/40"
          style="--reveal-delay: 250ms;"
        >
          <div class="flex items-center gap-3">
            <BellIcon class="size-5 text-primary" aria-hidden="true" />
            <h3 class="font-semibold text-foreground">Inbox</h3>
          </div>
          <div class="mt-4 space-y-2 text-sm">
            {[
              ["Noah requested changes", "2m"],
              ["CI finished for #48", "6m"],
              ["Ava replied in discounts.ts", "14m"],
            ].map((item) => (
              <div class="rounded-2xl border border-border bg-muted/40 p-3 dark:bg-white/[0.03]">
                <div class="flex items-center justify-between gap-3">
                  <span class="font-medium text-foreground">{item[0]}</span>
                  <span class="text-xs text-muted-foreground">{item[1]}</span>
                </div>
              </div>
            ))}
          </div>
        </div>

        <div
          class="reviu-reveal rounded-3xl border border-primary/20 bg-primary/10 p-5 shadow-sm"
          style="--reveal-delay: 350ms;"
        >
          <div class="flex items-center gap-3">
            <CircleCheckIcon class="size-5 text-primary" aria-hidden="true" />
            <h3 class="font-semibold text-foreground">Ready to merge</h3>
          </div>
          <div class="mt-4 space-y-2 text-sm">
            {
              mergeRows.map((row) => (
                <div class="flex items-center justify-between rounded-2xl border border-primary/20 bg-background/75 px-3 py-2 dark:bg-gray-950/40">
                  <span class="text-muted-foreground">{row[0]}</span>
                  <span class={`text-xs font-semibold ${row[2]}`}>{row[1]}</span>
                </div>
              ))
            }
          </div>
          <div class="mt-4 rounded-md bg-primary px-3.5 py-2.5 text-center text-sm font-semibold text-white">
            Create merge commit
          </div>
        </div>
      </div>
    </div>

    <div class="mt-10 grid gap-4 lg:grid-cols-3">
      {
        features.map((feature, index) => {
          const Icon = feature.icon;

          return (
            <article
              class="reviu-reveal rounded-3xl border border-border bg-background p-5 shadow-sm dark:bg-gray-950/40"
              style={`--reveal-delay: ${index * 80 + 300}ms;`}
            >
              <div class="flex size-11 items-center justify-center rounded-2xl bg-primary/10 text-primary ring-1 ring-primary/15">
                <Icon class="size-5" aria-hidden="true" />
              </div>
              <h3 class="mt-5 text-lg font-semibold text-foreground">
                {feature.name}
              </h3>
              <p class="mt-3 text-sm/7 text-muted-foreground">
                {feature.description}
              </p>
            </article>
          );
        })
      }
    </div>

    <div
      class="reviu-reveal mt-8 rounded-[2rem] border border-primary/20 bg-primary/10 p-5 shadow-sm sm:flex sm:items-center sm:justify-between sm:gap-6"
      style="--reveal-delay: 650ms;"
    >
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-primary">
          Incoming
        </p>
        <h3 class="mt-2 text-xl font-semibold tracking-tight text-foreground">
          Mobile and SSH remote workflows are next.
        </h3>
      </div>
      <div class="mt-4 flex flex-wrap gap-3 sm:mt-0 sm:justify-end">
        {
          incomingItems.map((item) => {
            const Icon = item.icon;

            return (
              <div class="inline-flex items-center gap-3 rounded-2xl border border-primary/20 bg-background/80 px-4 py-3 text-sm font-semibold text-foreground shadow-sm dark:bg-gray-950/40">
                <span class="flex size-9 items-center justify-center rounded-xl bg-primary/10 text-primary ring-1 ring-primary/15">
                  <Icon class="size-4" aria-hidden="true" />
                </span>
                {item.name}
              </div>
            );
          })
        }
      </div>
    </div>
  </div>
</section>
