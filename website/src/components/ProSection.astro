---
import prDark from "../assets/app_screenshots/pr_dark.png";
import prLight from "../assets/app_screenshots/pr_light.png";
import BellIcon from "@lucide/astro/icons/bell";
import GitMergeIcon from "@lucide/astro/icons/git-merge";
import GitPullRequestArrowIcon from "@lucide/astro/icons/git-pull-request-arrow";
import GitPullRequestCreateIcon from "@lucide/astro/icons/git-pull-request-create";
import MessageCircleReplyIcon from "@lucide/astro/icons/message-circle-reply";
import PuzzleIcon from "@lucide/astro/icons/puzzle";
import ThemePicture from "./ThemePicture.astro";
import { themeImageSources } from "../lib/themeImage";

const sectionImage = await themeImageSources(prLight, prDark, 3020, 1894);

const features = [
  {
    name: "The PR next to your working tree",
    description:
      "A dock tab shows the pull request for the branch you're on: description, commits, checks, and review threads, beside the actual code.",
    icon: GitPullRequestArrowIcon,
  },
  {
    name: "Open or create it in one click",
    description:
      "A button in the header connects your current branch to its pull request, or creates one without leaving Reviu.",
    icon: GitPullRequestCreateIcon,
  },
  {
    name: "Review with inline comments",
    description:
      "Comment on the PR diff - whole changeset or commit by commit - reply, resolve threads, and submit your review from the desktop.",
    icon: MessageCircleReplyIcon,
  },
  {
    name: "Checks and merge, no browser",
    description:
      "Track checks and merge readiness as they update, and merge when the branch is green.",
    icon: GitMergeIcon,
  },
  {
    name: "GitHub inbox in the sidebar",
    description:
      "Notifications land next to your sessions with an unread badge. Open one, deal with it, mark it done.",
    icon: BellIcon,
  },
  {
    name: "From github.com to a local checkout",
    description:
      "The browser extension opens a pull request in Reviu and offers to check out its branch, so you review with the whole project around it.",
    icon: PuzzleIcon,
  },
];
---

<section
  class="bg-background py-24 sm:py-32"
  data-reveal-root
  data-reveal-threshold="0.3"
>
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="reviu-reveal mx-auto max-w-2xl sm:text-center">
      <h2 class="text-base/7 font-semibold text-primary">Reviu Pro</h2>
      <p
        class="mt-2 text-4xl font-semibold tracking-tight text-pretty text-foreground sm:text-5xl sm:text-balance"
      >
        Your branch's pull request, right in the dock.
      </p>
      <p class="mt-6 text-lg/8 text-muted-foreground">
        Connect GitHub and the pull request follows your work: open it next to
        the diff, review it, track checks, and merge - without a browser tab.
      </p>
    </div>
  </div>
  <div class="relative overflow-hidden pt-16">
    <div
      class="reviu-reveal mx-auto max-w-7xl px-6 lg:px-8"
      style="--reveal-delay: 150ms;"
    >
      <ThemePicture
        sources={sectionImage}
        alt="Reviu pull request review screenshot"
        loading="lazy"
        class="mb-[-12%] rounded-sm sm:rounded-xl shadow-2xl ring-1 ring-gray-900/10 dark:ring-white/10"
      />
      <div aria-hidden="true" class="relative">
        <div
          class="absolute -inset-x-20 bottom-0 bg-linear-to-t from-background pt-[7%]"
        >
        </div>
      </div>
    </div>
  </div>
  <div class="mx-auto mt-16 max-w-7xl px-6 sm:mt-20 md:mt-24 lg:px-8">
    <dl
      class="mx-auto grid max-w-2xl grid-cols-1 gap-x-6 gap-y-10 text-base/7 text-muted-foreground sm:grid-cols-2 lg:mx-0 lg:max-w-none lg:grid-cols-3 lg:gap-x-8 lg:gap-y-16"
    >
      {
        features.map((feature, index) => {
          const Icon = feature.icon;

          return (
            <div
              class="reviu-reveal relative pl-9"
              style={`--reveal-delay: ${index * 80 + 200}ms;`}
            >
              <dt class="font-semibold text-foreground">
                <Icon
                  aria-hidden="true"
                  class="absolute top-1 left-1 size-5 text-primary"
                />
                {feature.name}
              </dt>
              <dd class="inline text-sm">{feature.description}</dd>
            </div>
          );
        })
      }
    </dl>
  </div>
</section>
