---
import sessionsDark from "../assets/app_screenshots/sessions_dark.png";
import sessionsLight from "../assets/app_screenshots/sessions_light.png";
import FileDiffIcon from "@lucide/astro/icons/file-diff";
import KeyRoundIcon from "@lucide/astro/icons/key-round";
import LayersIcon from "@lucide/astro/icons/layers";
import LockIcon from "@lucide/astro/icons/lock";
import MessageCircleReplyIcon from "@lucide/astro/icons/message-circle-reply";
import ReceiptTextIcon from "@lucide/astro/icons/receipt-text";
import ThemePicture from "./ThemePicture.astro";
import { themeImageSources } from "../lib/themeImage";

const sectionImage = await themeImageSources(
  sessionsLight,
  sessionsDark,
  3020,
  1894,
);

const features = [
  {
    name: "Parallel sessions, isolated worktrees",
    description:
      "Run several agents at once, each session in its own Git worktree. They never step on each other's changes, and you switch between them as they finish.",
    icon: LayersIcon,
  },
  {
    name: "Your subscription, not an API key",
    description:
      "Reviu drives the agent you already installed and signed into - Claude Code, Codex, Gemini, and twenty more from the official ACP registry. No key to paste, no separate inference bill.",
    icon: KeyRoundIcon,
  },
  {
    name: "The diff is always one click away",
    description:
      "Every file the agent touches lands in the Changes panel as it happens. Open it in a real diff editor, not a terminal scrollback.",
    icon: FileDiffIcon,
  },
  {
    name: "Inline comments go back to the agent",
    description:
      "Draft review comments on the exact lines you want changed, then send the batch to the agent in one action. No copy-paste.",
    icon: MessageCircleReplyIcon,
  },
  {
    name: "Every turn ends with a receipt",
    description:
      "Files edited, lines added and removed, per file. Each row opens its diff, Review jumps into the diff view, and Undo reverts the turn.",
    icon: ReceiptTextIcon,
  },
  {
    name: "Local and private by default",
    description:
      "Agents run as local processes on your machine. Your code never goes through Reviu's servers.",
    icon: LockIcon,
  },
];
---

<section
  class="bg-background py-24 sm:py-32"
  data-reveal-root
  data-reveal-threshold="0.3"
>
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="reviu-reveal mx-auto max-w-2xl sm:text-center">
      <h2 class="text-base/7 font-semibold text-primary">Agent sessions</h2>
      <p
        class="mt-2 text-4xl font-semibold tracking-tight text-pretty text-foreground sm:text-5xl sm:text-balance"
      >
        The agent works where you review.
      </p>
      <p class="mt-6 text-lg/8 text-muted-foreground">
        One window: sessions on the left, the conversation or the diff in the
        centre, your repository on the right. No terminal juggling, no
        copy-paste between apps.
      </p>
    </div>
  </div>
  <div class="relative overflow-hidden pt-16">
    <div
      class="reviu-reveal mx-auto max-w-7xl px-6 lg:px-8"
      style="--reveal-delay: 150ms;"
    >
      <ThemePicture
        sources={sectionImage}
        alt="Reviu agent sessions screenshot"
        loading="lazy"
        class="mb-[-12%] rounded-sm sm:rounded-xl shadow-2xl ring-1 ring-gray-900/10 dark:ring-white/10"
      />
      <div aria-hidden="true" class="relative">
        <div
          class="absolute -inset-x-20 bottom-0 bg-linear-to-t from-background pt-[7%]"
        >
        </div>
      </div>
    </div>
  </div>
  <div class="mx-auto mt-16 max-w-7xl px-6 sm:mt-20 md:mt-24 lg:px-8">
    <dl
      class="mx-auto grid max-w-2xl grid-cols-1 gap-x-6 gap-y-10 text-base/7 text-muted-foreground sm:grid-cols-2 lg:mx-0 lg:max-w-none lg:grid-cols-3 lg:gap-x-8 lg:gap-y-16"
    >
      {
        features.map((feature, index) => {
          const Icon = feature.icon;

          return (
            <div
              class="reviu-reveal relative pl-9"
              style={`--reveal-delay: ${index * 80 + 200}ms;`}
            >
              <dt class="font-semibold text-foreground">
                <Icon
                  aria-hidden="true"
                  class="absolute top-1 left-1 size-5 text-primary"
                />
                {feature.name}
              </dt>
              <dd class="inline text-sm">{feature.description}</dd>
            </div>
          );
        })
      }
    </dl>
  </div>
</section>
