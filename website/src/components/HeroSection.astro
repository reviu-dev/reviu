---
import GitBranchIcon from "@lucide/astro/icons/git-branch";
import DownloadIcon from "@lucide/astro/icons/download";
import GithubIcon from "../assets/icons/github.svg?raw";
import GitPullRequestIcon from "@lucide/astro/icons/git-pull-request";
import KeyboardIcon from "@lucide/astro/icons/keyboard";
import MessageCircleReplyIcon from "@lucide/astro/icons/message-circle-reply";
import SparklesIcon from "@lucide/astro/icons/sparkles";
import ZapIcon from "@lucide/astro/icons/zap";
import heroDark from "../assets/app_screenshots/hero_dark.png";
import heroLight from "../assets/app_screenshots/hero_light.png";
import LogoDark from "../assets/logo_dark.svg";
import LogoLight from "../assets/logo_light.svg";
import ThemePicture from "./ThemePicture.astro";
import { themeImageSources } from "../lib/themeImage";

const heroImage = await themeImageSources(heroLight, heroDark, 1400, 879);

const workflowPills = [
  {
    label: "Agent writes",
    detail: "Claude Code, Codex, Gemini",
    icon: SparklesIcon,
  },
  {
    label: "You review",
    detail: "Inline comments on local diffs",
    icon: MessageCircleReplyIcon,
  },
  {
    label: "Ship with Git",
    detail: "Stage, rebase, commit, push",
    icon: GitBranchIcon,
  },
  {
    label: "Finish in GitHub",
    detail: "PR, checks, review, merge",
    icon: GitPullRequestIcon,
  },
];
---

<section
  class="relative isolate overflow-hidden pt-10 pb-20 sm:pb-28 lg:pt-12"
  data-reveal-root
  data-reveal-threshold="0.1"
>
  <svg
    class="absolute inset-0 -z-10 size-full mask-[radial-gradient(100%_100%_at_top,white,transparent)] stroke-gray-200 dark:stroke-white/10"
    aria-hidden="true"
  >
    <defs>
      <pattern
        id="hero-grid"
        width="180"
        height="180"
        x="50%"
        y="-1"
        patternUnits="userSpaceOnUse"
      >
        <path d="M.5 180V.5H180" fill="none"></path>
      </pattern>
    </defs>
    <rect width="100%" height="100%" stroke-width="0" fill="url(#hero-grid)"
    ></rect>
  </svg>

  <div
    class="absolute top-0 left-1/2 -z-10 h-120 w-220 -translate-x-1/2 rounded-full bg-primary/15 blur-3xl dark:bg-primary/20"
    aria-hidden="true"
  >
  </div>
  <div
    class="absolute top-72 left-1/2 -z-10 h-64 w-180 -translate-x-1/2 rounded-full bg-cyan-400/10 blur-3xl dark:bg-cyan-400/15"
    aria-hidden="true"
  >
  </div>

  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="reviu-reveal flex justify-center">
      <span class="sr-only">Reviu</span>
      <LogoDark class="h-12 w-auto dark:hidden sm:h-14" aria-hidden="true" />
      <LogoLight
        class="h-12 w-auto not-dark:hidden sm:h-14"
        aria-hidden="true"
      />
    </div>

    <div class="reviu-reveal mt-8 flex justify-center" style="--reveal-delay: 100ms;">
      <a
        href="/changelog"
        data-umami-event="v1-badge-hero"
        class="inline-flex items-center gap-2 rounded-full bg-primary/10 px-3 py-1 text-sm/6 font-semibold text-primary ring-1 ring-primary/20 ring-inset transition-colors hover:bg-primary/15 dark:ring-primary/25"
      >
        <span
          class="rounded-full bg-primary px-2 py-0.5 text-xs font-semibold text-white"
        >
          v1.0
        </span>
        Reviu 1.0 is here <span aria-hidden="true">→</span>
      </a>
    </div>

    <div class="mx-auto mt-9 max-w-5xl text-center">
      <h1
        class="reviu-reveal text-5xl font-semibold tracking-tight text-balance text-foreground sm:text-7xl"
        style="--reveal-delay: 200ms;"
      >
        The review app for code your agent writes.
      </h1>

      <p
        class="reviu-reveal mx-auto mt-8 max-w-3xl text-lg font-medium text-pretty text-muted-foreground sm:text-xl/8"
        style="--reveal-delay: 300ms;"
      >
        Start Claude Code or Codex, watch the session, review every diff, send
        line comments back, then stage, rebase, commit, and open the PR without
        leaving Reviu.
      </p>
    </div>

    <div
      id="download"
      class="reviu-reveal mt-10 flex flex-wrap items-center justify-center gap-x-4 gap-y-3"
      style="--reveal-delay: 450ms;"
    >
      <a
        href="#downloads"
        data-umami-event="download-hero"
        aria-describedby="hero-download-hint"
        class="reviu-hover-lift rounded-md bg-primary px-4 py-2.5 text-sm font-semibold text-white shadow-xs transition-colors hover:bg-primary/80 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary flex items-center gap-2"
      >
        <DownloadIcon class="size-4" aria-hidden="true" />
        Download now
      </a>
      <a
        href="#pricing"
        data-umami-event="see-pricing-hero"
        class="rounded-md px-3 py-2 text-sm/6 font-semibold text-foreground hover:bg-muted/50"
      >
        See Pro pricing <span aria-hidden="true">→</span>
      </a>
      <a
        href="https://github.com/reviu-dev/reviu"
        target="_blank"
        rel="noopener noreferrer"
        data-umami-event="github-repo-hero"
        class="inline-flex items-center gap-2 rounded-md px-3 py-2 text-sm/6 font-semibold text-foreground hover:bg-muted/50"
      >
        <span
          class="inline-flex size-4 [&_svg]:size-4"
          aria-hidden="true"
          set:html={GithubIcon}
        />
        View source
      </a>
    </div>

    <div
      class="reviu-reveal relative mx-auto mt-10 max-w-6xl sm:mt-12"
      style="--reveal-delay: 600ms;"
    >
      <div
        class="absolute -inset-x-12 -top-10 -bottom-16 -z-10 rounded-[3rem] bg-linear-to-b from-primary/10 via-background to-background blur-2xl dark:from-primary/20 dark:via-background/60"
        aria-hidden="true"
      >
      </div>
      <div
        class="rounded-[2rem] border border-gray-900/10 bg-white/75 p-2 shadow-2xl shadow-primary/10 backdrop-blur sm:p-3 dark:border-white/10 dark:bg-white/5 dark:shadow-black/30"
      >
        <div class="relative mx-auto w-fit max-w-full overflow-hidden rounded-[1.35rem] bg-gray-950/5 ring-1 ring-gray-900/10 dark:ring-white/10">
          <ThemePicture
            sources={heroImage}
            alt="Reviu desktop app with agent sessions, diff review, changes, and pull request workflow"
            loading="eager"
            fetchpriority="high"
            class="mx-auto h-auto max-h-[52vh] w-auto max-w-full"
          />
          <div
            class="absolute top-4 left-4 hidden max-w-56 rounded-2xl border border-white/70 bg-white/85 p-4 text-left shadow-xl backdrop-blur md:block dark:border-white/10 dark:bg-gray-950/80"
          >
            <p class="flex items-center gap-2 text-xs font-semibold text-primary">
              <span class="size-2 rounded-full bg-emerald-500"></span>
              Agent session running
            </p>
            <p class="mt-2 text-sm font-semibold text-foreground">
              Add percentage discounts that stack with flat discounts
            </p>
          </div>
          <div
            class="absolute right-4 bottom-4 hidden max-w-64 rounded-2xl border border-white/70 bg-white/85 p-4 text-left shadow-xl backdrop-blur md:block dark:border-white/10 dark:bg-gray-950/80"
          >
            <p class="flex items-center gap-2 text-xs font-semibold text-primary">
              <MessageCircleReplyIcon class="size-4" aria-hidden="true" />
              Review batch ready
            </p>
            <p class="mt-2 text-sm text-muted-foreground">
              3 line comments can go back to the agent before you commit.
            </p>
          </div>
        </div>
      </div>
    </div>

    <div
      class="reviu-reveal mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-4"
      style="--reveal-delay: 750ms;"
    >
      {
        workflowPills.map((pill) => {
          const Icon = pill.icon;

          return (
            <div class="rounded-2xl border border-border bg-background/70 px-4 py-3 text-sm shadow-sm backdrop-blur dark:bg-white/5">
              <div class="flex items-center gap-2 font-semibold text-foreground">
                <Icon class="size-4 text-primary" aria-hidden="true" />
                {pill.label}
              </div>
              <p class="mt-1 text-xs text-muted-foreground">{pill.detail}</p>
            </div>
          );
        })
      }
    </div>

    <div
      class="reviu-reveal mt-8 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm/6 text-muted-foreground"
      style="--reveal-delay: 850ms;"
    >
      <span class="inline-flex items-center gap-2">
        <ZapIcon class="size-4 text-primary" aria-hidden="true" />
        Rust · GPU-accelerated
      </span>
      <span class="inline-flex items-center gap-2">
        <KeyboardIcon class="size-4 text-primary" aria-hidden="true" />
        Keyboard-first
      </span>
      <span class="inline-flex items-center gap-2">
        <GitPullRequestIcon class="size-4 text-primary" aria-hidden="true" />
        GitHub PRs in-app
      </span>
    </div>
  </div>
</section>
