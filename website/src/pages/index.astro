---
import HeroSection from "../components/HeroSection.astro";
import ReviewLoopSection from "../components/ReviewLoopSection.astro";
import AgentSessionsSection from "../components/AgentSessionsSection.astro";
import GitFeaturesSection from "../components/GitFeaturesSection.astro";
import ProSection from "../components/ProSection.astro";
import PricingSection from "../components/PricingSection.astro";
import BrowserExtensionsSection from "../components/BrowserExtensionsSection.astro";
import DownloadSection from "../components/DownloadSection.astro";
import FaqSection from "../components/FaqSection.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Layout from "../layouts/Layout.astro";

const description =
  "Reviu is a native Rust desktop app for managing coding-agent sessions, reviewing every diff, sending line comments back to the agent, and finishing the branch with real Git. Reviu Pro puts GitHub pull requests, checks, review, merge, and notifications in the same window.";

const faqItems: { question: string; answer: string }[] = [
  {
    question: "What is Reviu?",
    answer:
      "Reviu is a native desktop app built with Rust and GPUI for managing coding-agent sessions. Run Claude Code, Codex, Gemini, or another ACP-registry agent, review every diff, send line comments back, then stage, commit, and push with real Git underneath - all free. Reviu Pro adds GitHub: your branch's pull request in the dock, review, checks, merge, and a notifications inbox.",
  },
  {
    question: "Which agents does Reviu support?",
    answer:
      "Any agent from the official Agent Client Protocol registry: Claude Code, Codex, Gemini, Copilot, Cline, and about twenty others. Reviu drives the CLI you already installed and signed into, so agents run with your existing subscription - no API key to paste. Agents run as local processes on your machine.",
  },
  {
    question: "Do I need Pro to review agent code?",
    answer:
      "No. Agent sessions, local diff review, inline comments sent back to the agent, parallel worktrees, and local Git workflows are free. Reviu Pro adds GitHub pull requests in the dock, GitHub review comments, checks, merge actions, notifications, and the browser extension.",
  },
  {
    question: "Where does Reviu fit if I already have Git tooling?",
    answer:
      "Keep the tools you like. Reviu is built for the loop that starts before the commit: the agent works in a durable session, you review the diff, send fixes back from inline comments, then finish with hunk staging, interactive rebase, conflicts, history, and push in the same app. Pro adds your branch's pull request in the dock.",
  },
  {
    question: "Does Reviu run agents in the cloud?",
    answer:
      "No. Reviu launches the agent CLI you already installed and signed into, so the agent runs as a local process on your machine. Reviu Pro connects that local workflow to GitHub pull requests, checks, reviews, merge, and notifications.",
  },
  {
    question: "Is Reviu built with a webview?",
    answer:
      'No. Reviu is a fully native desktop app built with <a href="https://gpui.rs" target="_blank" rel="noopener noreferrer" class="text-primary underline hover:text-primary/80">gpui.rs</a>, a Rust-based GPU-accelerated UI framework. No Electron, no webview - just native performance.',
  },

  {
    question: "Do I need an account to use Reviu?",
    answer:
      "No. Agent sessions and all local Git features work without an account. Signing in is only required for the GitHub integration in Reviu Pro.",
  },
  {
    question: "Which platforms does Reviu support?",
    answer:
      "Reviu supports macOS (Apple Silicon and Intel), Windows (ARM64 and x64), and Linux through the install command on the download section.",
  },
];

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "Reviu",
    applicationCategory: "DeveloperApplication",
    operatingSystem: "macOS, Linux, Windows",
    url: "https://reviu.dev/",
    sameAs: ["https://github.com/reviu-dev/reviu"],
    description,
    offers: [
      {
        "@type": "Offer",
        name: "Reviu Free",
        price: "0",
        priceCurrency: "USD",
      },
      {
        "@type": "Offer",
        name: "Reviu Pro Monthly",
        price: "9",
        priceCurrency: "USD",
      },
      {
        "@type": "Offer",
        name: "Reviu Pro Annual",
        price: "79",
        priceCurrency: "USD",
      },
    ],
    featureList: [
      "Native Rust GPU-accelerated desktop application",
      "Agent sessions with Claude Code, Codex, Gemini, and ACP-registry agents",
      "Parallel agent sessions in isolated Git worktrees",
      "Inline review comments sent back to the agent",
      "Split center view for agent chat, files, diffs, and terminal",
      "Real-time diff editor with inline and split views",
      "Hunk-level staging, editing, and restore in the diff",
      "Interactive rebase and conflict resolution",
      "Commit history with per-commit file views",
      "Built-in terminal",
      "Keyboard-first command palette",
      "GitHub pull request review, checks, and merge in Reviu Pro",
      "GitHub notifications inbox in Reviu Pro",
      "Browser extension that opens pull requests as local checkouts",
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqItems.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.answer,
      },
    })),
  },
];
---

<Layout description={description} pathname="/" structuredData={structuredData}>
  <main>
    <HeroSection />
    <ReviewLoopSection />
    <AgentSessionsSection />
    <GitFeaturesSection />
    <ProSection />
    <PricingSection />
    <BrowserExtensionsSection />
    <DownloadSection />
    <FaqSection faqItems={faqItems} />
    <SiteFooter />
  </main>
</Layout>
