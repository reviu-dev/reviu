---
import HeroSection from "../components/HeroSection.astro";
import ReviewLoopSection from "../components/ReviewLoopSection.astro";
import AgentSessionsSection from "../components/AgentSessionsSection.astro";
import GitFeaturesSection from "../components/GitFeaturesSection.astro";
import ProSection from "../components/ProSection.astro";
import PricingSection from "../components/PricingSection.astro";
import BrowserExtensionsSection from "../components/BrowserExtensionsSection.astro";
import DownloadSection from "../components/DownloadSection.astro";
import FaqSection from "../components/FaqSection.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Layout from "../layouts/Layout.astro";

const description =
  "Reviu is a native Rust desktop app where Claude Code or Codex writes the diff and you review it for real: inline comments back to the agent, hunk staging, interactive rebase, conflicts, and history - free. Reviu Pro puts your branch's GitHub pull request, checks, and merge in the same window.";

const faqItems: { question: string; answer: string }[] = [
  {
    question: "What is Reviu?",
    answer:
      "Reviu is a native desktop app built with Rust and GPUI where a coding agent works and you review what it did, with a real Git client underneath. Run Claude Code or Codex in agent sessions, read every diff, send fixes back, then stage, commit, and push - all free. Reviu Pro adds GitHub: your branch's pull request in the dock, review, checks, merge, and a notifications inbox.",
  },
  {
    question: "Which agents does Reviu support?",
    answer:
      "Any agent from the official Agent Client Protocol registry: Claude Code, Codex, Gemini, Copilot, Cline, and about twenty others. Reviu drives the CLI you already installed and signed into, so agents run with your existing subscription - no API key to paste. Agents run as local processes on your machine.",
  },
  {
    question: "Can I review my agent's code inside Reviu?",
    answer:
      "Yes, that's the point. Review the diff your agent produced in a real editor, leave inline review comments on the lines you want changed, and send them back to the agent without copy-paste. You can also run several sessions in parallel, each in its own isolated Git worktree.",
  },
  {
    question: "Why use Reviu if I already use Fork, Tower, or GitKraken?",
    answer:
      "Those are strong Git clients. Reviu is built for the loop that starts before the commit: the agent writes the diff in the same window, you review it and send fixes back. You still keep a full Git client - hunk staging, interactive rebase, conflicts, history - and Pro adds your branch's pull request in the dock.",
  },
  {
    question: "How is Reviu different from GitHub Desktop?",
    answer:
      "GitHub Desktop is great for opening a pull request branch locally. Reviu keeps the pull request next to your working tree: review with inline comments, reply, resolve threads, track checks, and merge from the desktop - plus the agent sessions and a deeper local Git toolset.",
  },
  {
    question: "Is Reviu built with a webview?",
    answer:
      'No. Reviu is a fully native desktop app built with <a href="https://gpui.rs" target="_blank" rel="noopener noreferrer" class="text-primary underline hover:text-primary/80">gpui.rs</a>, a Rust-based GPU-accelerated UI framework. No Electron, no webview - just native performance.',
  },
  {
    question: "Is Reviu open source?",
    answer:
      'Reviu is source-available. The full desktop client lives in a public <a href="https://github.com/reviu-dev/reviu" target="_blank" rel="noopener noreferrer" class="text-primary underline hover:text-primary/80">GitHub repository</a> under the Functional Source License (FSL-1.1), and each release converts to Apache-2.0 two years after it ships. You can read, build, and modify it for any non-competing use. The GitHub-integration backend that powers Reviu Pro stays closed-source.',
  },
  {
    question: "Do I need an account to use Reviu?",
    answer:
      "No. Agent sessions and all local Git features work without an account. Signing in is only required for the GitHub integration in Reviu Pro.",
  },
  {
    question: "Which platforms does Reviu support?",
    answer:
      "Reviu supports macOS (Apple Silicon and Intel), Windows (ARM64 and x64), and Linux through the install command on the download section.",
  },
];

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "Reviu",
    applicationCategory: "DeveloperApplication",
    operatingSystem: "macOS, Linux, Windows",
    url: "https://reviu.dev/",
    sameAs: ["https://github.com/reviu-dev/reviu"],
    description,
    offers: [
      {
        "@type": "Offer",
        name: "Reviu Free",
        price: "0",
        priceCurrency: "USD",
      },
      {
        "@type": "Offer",
        name: "Reviu Pro Monthly",
        price: "9",
        priceCurrency: "USD",
      },
      {
        "@type": "Offer",
        name: "Reviu Pro Annual",
        price: "79",
        priceCurrency: "USD",
      },
    ],
    featureList: [
      "Native Rust GPU-accelerated desktop application",
      "Agent sessions with Claude Code and Codex",
      "Parallel agent sessions in isolated Git worktrees",
      "Inline review comments sent back to the agent",
      "Real-time diff editor with inline and split views",
      "Hunk-level staging, editing, and restore in the diff",
      "Interactive rebase and conflict resolution",
      "Commit history with per-commit file views",
      "Built-in terminal",
      "Keyboard-first command palette",
      "GitHub pull request review, checks, and merge in Reviu Pro",
      "GitHub notifications inbox in Reviu Pro",
      "Browser extension that opens pull requests as local checkouts",
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqItems.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.answer,
      },
    })),
  },
];
---

<Layout description={description} pathname="/" structuredData={structuredData}>
  <main>
    <HeroSection />
    <ReviewLoopSection />
    <AgentSessionsSection />
    <GitFeaturesSection />
    <ProSection />
    <PricingSection />
    <BrowserExtensionsSection />
    <DownloadSection />
    <FaqSection faqItems={faqItems} />
    <SiteFooter />
  </main>
</Layout>
