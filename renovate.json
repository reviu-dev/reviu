{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "mode": "full",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "rangeStrategy": "bump",
  "platformAutomerge": true,
  "minimumReleaseAge": "3 days",
  "postUpdateOptions": ["pnpmDedupe"],
  "lockFileMaintenance": { "enabled": true },
  "ignorePaths": ["desktop/vendor/**"],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "matchManagers": ["github-actions"],
      "automerge": true
    },
    {
      "description": "ACP is pinned exactly and built on the crate's unstable feature: the spec moves faster than its version numbers. Bump deliberately, never on a bot's schedule.",
      "matchManagers": ["cargo"],
      "matchPackageNames": [
        "agent-client-protocol",
        "agent-client-protocol-schema"
      ],
      "enabled": false
    },
    {
      "description": "gpui/zed git deps drive the vendored GPL strip (sum_tree). Review manually, never automerge.",
      "matchManagers": ["cargo"],
      "matchPackageNames": [
        "gpui",
        "gpui_platform",
        "reqwest_client",
        "gpui-component",
        "gpui-component-assets"
      ],
      "automerge": false
    },
    {
      "description": "tree-sitter-highlight pins the tree-sitter minor it was built against, so the two only resolve when bumped together. Grammars depend on tree-sitter-language and move on their own.",
      "matchManagers": ["cargo"],
      "matchPackageNames": ["tree-sitter", "tree-sitter-highlight"],
      "groupName": "tree-sitter core"
    },
    {
      "description": "libappindicator 0.9 (unmaintained since 2023) requires gtk-sys 0.18.",
      "matchManagers": ["cargo"],
      "matchPackageNames": ["gtk"],
      "allowedVersions": "<0.19"
    },
    {
      "description": "tree-sitter-sequel requires cc ~1.2.",
      "matchManagers": ["cargo"],
      "matchPackageNames": ["cc"],
      "allowedVersions": "<1.3"
    },
    {
      "description": "astro check relies on the TypeScript programmatic API, which the native 7.x compiler does not ship yet.",
      "matchManagers": ["npm"],
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7"
    }
  ]
}
