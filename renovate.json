{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "mode": "full",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "rangeStrategy": "bump",
  "platformAutomerge": true,
  "minimumReleaseAge": "3 days",
  "postUpdateOptions": ["pnpmDedupe"],
  "lockFileMaintenance": { "enabled": true },
  "ignorePaths": ["desktop/vendor/**"],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "matchManagers": ["github-actions"],
      "automerge": true
    },
    {
      "description": "ACP is pinned exactly and built on the crate's unstable feature: the spec moves faster than its version numbers. Bump deliberately, never on a bot's schedule.",
      "matchManagers": ["cargo"],
      "matchPackageNames": [
        "agent-client-protocol",
        "agent-client-protocol-schema"
      ],
      "enabled": false
    },
    {
      "description": "gpui/zed git deps drive the vendored GPL strip (sum_tree). Review manually, never automerge.",
      "matchManagers": ["cargo"],
      "matchPackageNames": [
        "gpui",
        "gpui_platform",
        "reqwest_client",
        "gpui-component",
        "gpui-component-assets",
        "gpui-router"
      ],
      "automerge": false
    }
  ]
}
