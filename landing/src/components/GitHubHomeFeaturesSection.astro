---
import gitHubHomeDark from "../assets/app_screenshots/github_home_dark.png";
import gitHubHomeLight from "../assets/app_screenshots/github_home_light.png";
import BadgeCheckIcon from "@lucide/astro/icons/badge-check";
import BellIcon from "@lucide/astro/icons/bell";
import CommandIcon from "@lucide/astro/icons/command";
import FolderIcon from "@lucide/astro/icons/folder";
import GitPullRequestArrowIcon from "@lucide/astro/icons/git-pull-request-arrow";
import { Image } from "astro:assets";
import SearchCheckIcon from "@lucide/astro/icons/search-check";

const features = [
  {
    name: "Keep GitHub notifications in the app.",
    description:
      "See unread work immediately from a desktop inbox with reasons, repo sections, and quick search.",
    icon: BellIcon,
  },
  {
    name: "Browse your repositories quickly.",
    description:
      "Keep your active repositories close with search, recent updates, pinned repos, and private repo visibility.",
    icon: FolderIcon,
  },
  {
    name: "Build review queues that match your workflow.",
    description:
      "Save tabs like My Open PRs or Need Review and keep each list focused on the pull requests that matter.",
    icon: GitPullRequestArrowIcon,
  },
  {
    name: "Manage tabs instead of one endless list.",
    description:
      "Create, edit, reorder, and remove saved pull request lists directly from the GitHub home page.",
    icon: BadgeCheckIcon,
  },
  {
    name: "Search every panel fast.",
    description:
      "Filter notifications, repositories, and pull requests without leaving the desktop app.",
    icon: SearchCheckIcon,
  },
  {
    name: "Jump with the command palette.",
    description:
      "Open GitHub views and move between Git and GitHub surfaces from the same keyboard-first workflow.",
    icon: CommandIcon,
  },
];
---

<section
  class="bg-background py-24 sm:py-32"
  data-reveal-root
  data-reveal-threshold="0.3"
>
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="reviu-reveal mx-auto max-w-2xl sm:text-center">
      <h2 class="text-base/7 font-semibold text-primary">Reviu Pro</h2>
      <p
        class="mt-2 text-4xl font-semibold tracking-tight text-pretty text-foreground sm:text-5xl sm:text-balance"
      >
        A GitHub home page built for daily review work
      </p>
      <p class="mt-6 text-lg/8 text-muted-foreground">
        Start from one desktop home for notifications, repositories, and saved
        pull request lists, then jump into the right review flow faster.
      </p>
    </div>
  </div>
  <div class="relative overflow-hidden pt-16">
    <div
      class="reviu-reveal mx-auto max-w-7xl px-6 lg:px-8"
      style="--reveal-delay: 150ms;"
    >
      <Image
        width="2432"
        height="1442"
        src={gitHubHomeLight}
        alt="Reviu GitHub home screenshot in light mode"
        class="mb-[-12%] rounded-xl shadow-2xl ring-1 ring-gray-900/10 dark:hidden"
      />
      <Image
        width="2432"
        height="1442"
        src={gitHubHomeDark}
        alt="Reviu GitHub home screenshot in dark mode"
        class="mb-[-12%] rounded-xl shadow-2xl ring-1 ring-white/10 not-dark:hidden"
      />
      <div aria-hidden="true" class="relative">
        <div
          class="absolute -inset-x-20 bottom-0 bg-linear-to-t from-background pt-[7%]"
        >
        </div>
      </div>
    </div>
  </div>
  <div class="mx-auto mt-16 max-w-7xl px-6 sm:mt-20 md:mt-24 lg:px-8">
    <dl
      class="mx-auto grid max-w-2xl grid-cols-1 gap-x-6 gap-y-10 text-base/7 text-muted-foreground sm:grid-cols-2 lg:mx-0 lg:max-w-none lg:grid-cols-3 lg:gap-x-8 lg:gap-y-16"
    >
      {
        features.map((feature, index) => {
          const Icon = feature.icon;

          return (
            <div
              class="reviu-reveal relative pl-9"
              style={`--reveal-delay: ${index * 80 + 200}ms;`}
            >
              <dt class="font-semibold text-foreground">
                <Icon
                  aria-hidden="true"
                  class="absolute top-1 left-1 size-5 text-primary"
                />
                {feature.name}
              </dt>
              <dd class="inline">{feature.description}</dd>
            </div>
          );
        })
      }
    </dl>
  </div>
</section>
