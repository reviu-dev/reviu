---
import CommandIcon from "@lucide/astro/icons/command";
import GitPullRequestIcon from "@lucide/astro/icons/git-pull-request";
import GitCommitHorizontalIcon from "@lucide/astro/icons/git-commit-horizontal";
import GitMergeConflictIcon from "@lucide/astro/icons/git-merge-conflict";
import PencilLineIcon from "@lucide/astro/icons/pencil-line";
import SplitIcon from "@lucide/astro/icons/split";
import Badge from "./Badge.astro";
import { Image } from "astro:assets";
import gitDark from "../assets/app_screenshots/git_dark.png";
import gitLight from "../assets/app_screenshots/git_light.png";

const features = [
  {
    name: "A real-time diff editor",
    description:
      "Edit your changes directly inside the diff view. Review and modify code in one place instead of switching between your editor and your Git client.",
    icon: PencilLineIcon,
  },
  {
    name: "Inline and split diff views",
    description:
      "Switch between inline and split diff layouts. Stage, unstage, and restore individual hunks to keep your commits precise.",
    icon: SplitIcon,
  },
  {
    name: "Resolve conflicts without leaving the app.",
    description:
      "Handle merge conflicts with dedicated actions, pick sides, edit the result, and move on.",
    icon: GitMergeConflictIcon,
  },
  {
    name: "The full local Git workflow",
    description:
      "Commit, amend, undo, fetch, pull, push, force push with lease, branch, rebase, stash, and cherry-pick - all in one place.",
    icon: GitCommitHorizontalIcon,
  },
  {
    name: "Keyboard-first command palette",
    description:
      "Every Git action is reachable from the command palette. Navigate and operate entirely from the keyboard.",
    icon: CommandIcon,
  },
  {
    name: "Your branch, your PR, one click away",
    description:
      "A button in the header connects your current branch to its pull request. Open an existing PR or create a new one without leaving Reviu. Requires Reviu Pro.",
    icon: GitPullRequestIcon,
    pro: true,
  },
];
---

<section
  id="features"
  class="bg-background py-24 sm:py-32"
  data-reveal-root
  data-reveal-threshold="0.3"
>
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="reviu-reveal mx-auto max-w-2xl sm:text-center">
      <h2 class="text-base/7 font-semibold text-primary">Free Local Git</h2>
      <p
        class="mt-2 text-4xl font-semibold tracking-tight text-pretty text-foreground sm:text-5xl sm:text-balance"
      >
        Local Git, built for reviewing and committing fast.
      </p>
      <p class="mt-6 text-lg/8 text-muted-foreground">
        No account needed. Review diffs, resolve conflicts, and commit - all
        from the keyboard.
      </p>
    </div>
  </div>
  <div class="relative overflow-hidden pt-16">
    <div
      class="reviu-reveal mx-auto max-w-7xl px-6 lg:px-8"
      style="--reveal-delay: 150ms;"
    >
      <Image
        width="2432"
        height="1442"
        src={gitLight}
        alt="Reviu Git conflict resolution screenshot in light mode"
        class="mb-[-12%] rounded-sm sm:rounded-xl shadow-2xl ring-1 ring-gray-900/10 dark:hidden"
      />
      <Image
        width="2432"
        height="1442"
        src={gitDark}
        alt="Reviu Git conflict resolution screenshot in dark mode"
        class="mb-[-12%] rounded-sm sm:rounded-xl shadow-2xl ring-1 ring-white/10 not-dark:hidden"
      />
      <div aria-hidden="true" class="relative">
        <div
          class="absolute -inset-x-20 bottom-0 bg-linear-to-t from-background pt-[7%]"
        >
        </div>
      </div>
    </div>
  </div>
  <div class="mx-auto mt-16 max-w-7xl px-6 sm:mt-20 md:mt-24 lg:px-8">
    <dl
      class="mx-auto grid max-w-2xl grid-cols-1 gap-x-6 gap-y-10 text-base/7 text-muted-foreground sm:grid-cols-2 lg:mx-0 lg:max-w-none lg:grid-cols-3 lg:gap-x-8 lg:gap-y-16"
    >
      {
        features.map((feature, index) => {
          const Icon = feature.icon;

          return (
            <div
              class="reviu-reveal relative pl-9"
              style={`--reveal-delay: ${index * 80 + 200}ms;`}
            >
              <dt class="flex items-start gap-2 font-semibold text-foreground">
                <span>
                  <Icon
                    aria-hidden="true"
                    class="absolute top-1 left-1 size-5 text-primary"
                  />
                  {feature.name}
                </span>
                {feature.pro && <Badge compact>Pro</Badge>}
              </dt>
              <dd class="inline text-sm">{feature.description}</dd>
            </div>
          );
        })
      }
    </dl>
  </div>
</section>
