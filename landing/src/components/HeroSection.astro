---
import GitBranchIcon from "@lucide/astro/icons/git-branch";
import DownloadIcon from "@lucide/astro/icons/download";
import GithubIcon from "../assets/icons/github.svg?raw";
import GitPullRequestIcon from "@lucide/astro/icons/git-pull-request";
import KeyboardIcon from "@lucide/astro/icons/keyboard";
import ZapIcon from "@lucide/astro/icons/zap";
import gitDark from "../assets/app_screenshots/git_dark.png";
import gitLight from "../assets/app_screenshots/git_light.png";
import LogoDark from "../assets/logo_dark.svg";
import LogoLight from "../assets/logo_light.svg";
import ThemePicture from "./ThemePicture.astro";
import { themeImageSources } from "../lib/themeImage";

const heroImage = await themeImageSources(gitLight, gitDark, 1400, 829);
---

<section
  class="relative isolate overflow-hidden"
  data-reveal-root
  data-reveal-threshold="0.1"
>
  <svg
    class="absolute inset-0 -z-10 size-full mask-[radial-gradient(100%_100%_at_top_right,white,transparent)] stroke-gray-200 dark:stroke-white/10"
    aria-hidden="true"
  >
    <defs>
      <pattern
        id="hero-grid"
        width="200"
        height="200"
        x="50%"
        y="-1"
        patternUnits="userSpaceOnUse"
      >
        <path d="M.5 200V.5H200" fill="none"></path>
      </pattern>
    </defs>
    <svg
      x="50%"
      y="-1"
      class="overflow-visible fill-gray-50 dark:fill-gray-800/20"
    >
      <path
        d="M-200 0h201v201h-201Z M600 0h201v201h-201Z M-400 600h201v201h-201Z M200 800h201v201h-201Z"
        stroke-width="0"></path>
    </svg>
    <rect width="100%" height="100%" stroke-width="0" fill="url(#hero-grid)"
    ></rect>
  </svg>

  <div
    class="absolute top-10 left-[calc(50%-4rem)] -z-10 transform-gpu blur-3xl sm:left-[calc(50%-18rem)] lg:top-[calc(50%-30rem)] lg:left-48 xl:left-[calc(50%-24rem)]"
    aria-hidden="true"
  >
    <div
      class="aspect-1108/632 w-277 bg-linear-to-r from-[#80caff] to-[#4f46e5] opacity-20"
      style="clip-path: polygon(73.6% 51.7%, 91.7% 11.8%, 100% 46.4%, 97.4% 82.2%, 92.5% 84.9%, 75.7% 64%, 55.3% 47.5%, 46.5% 49.4%, 45% 62.9%, 50.3% 87.2%, 21.3% 64.1%, 0.1% 100%, 5.4% 51.1%, 21.4% 63.9%, 58.9% 0.2%, 73.6% 51.7%)"
    >
    </div>
  </div>

  <div
    class="mx-auto max-w-7xl px-6 pt-10 pb-24 sm:pb-32 lg:flex lg:px-8 lg:py-40"
  >
    <div class="mx-auto max-w-2xl shrink-0 lg:mx-0 lg:pt-8">
      <div class="reviu-reveal">
        <span class="sr-only">Reviu</span>
        <LogoDark class="h-14 w-auto dark:hidden sm:h-16" aria-hidden="true" />
        <LogoLight
          class="h-14 w-auto not-dark:hidden sm:h-16"
          aria-hidden="true"
        />
      </div>

      <div class="reviu-reveal mt-8 sm:mt-16" style="--reveal-delay: 100ms;">
        <span
          class="inline-flex rounded-full bg-primary/10 px-3 py-1 text-sm/6 font-semibold text-primary ring-1 ring-primary/20 ring-inset dark:ring-primary/25"
        >
          Local Git · AI review · GitHub PRs
        </span>
      </div>

      <h1
        class="reviu-reveal mt-10 text-4xl font-semibold tracking-tight text-pretty text-foreground sm:text-6xl"
        style="--reveal-delay: 200ms;"
      >
        Review your agent's code before you push.
      </h1>

      <p
        class="reviu-reveal mt-8 text-lg font-medium text-pretty text-muted-foreground sm:text-xl/8"
        style="--reveal-delay: 300ms;"
      >
        Your agent writes the diff. You read it, comment, and send fixes back -
        all in Reviu, free. Upgrade to Pro to review and merge GitHub pull
        requests in the same native app.
      </p>

      <div
        class="reviu-reveal mt-8 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm/6 text-muted-foreground"
        style="--reveal-delay: 500ms;"
      >
        <span class="inline-flex items-center gap-2">
          <ZapIcon class="size-4 text-primary" aria-hidden="true" />
          Rust · GPU-accelerated
        </span>
        <span class="inline-flex items-center gap-2">
          <KeyboardIcon class="size-4 text-primary" aria-hidden="true" />
          Keyboard-first
        </span>
        <span class="inline-flex items-center gap-2">
          <GitBranchIcon class="size-4 text-primary" aria-hidden="true" />
          Full local Git
        </span>
        <span class="inline-flex items-center gap-2">
          <GitPullRequestIcon class="size-4 text-primary" aria-hidden="true" />
          PR review in-app
        </span>
      </div>

      <div
        id="download"
        class="reviu-reveal mt-10 flex flex-wrap items-center gap-x-6 gap-y-3"
        style="--reveal-delay: 700ms;"
      >
        <a
          href="#downloads"
          data-umami-event="download-hero"
          aria-describedby="hero-download-hint"
          class="reviu-hover-lift rounded-md bg-primary px-3.5 py-2.5 text-sm font-semibold text-white shadow-xs transition-colors hover:bg-primary/80 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary flex items-center gap-2"
        >
          <DownloadIcon class="size-4" aria-hidden="true" />
          Download now
        </a>
        <a
          href="#pricing"
          data-umami-event="see-pricing-hero"
          class="rounded-md px-3 py-2 text-sm/6 font-semibold text-foreground hover:bg-muted/50"
        >
          See Pro pricing <span aria-hidden="true">→</span>
        </a>
        <a
          href="https://github.com/reviu-dev/reviu"
          target="_blank"
          rel="noopener noreferrer"
          data-umami-event="star-github-hero"
          class="inline-flex items-center gap-2 rounded-md px-3 py-2 text-sm/6 font-semibold text-foreground hover:bg-muted/50"
        >
          <span
            class="inline-flex size-4 [&_svg]:size-4"
            aria-hidden="true"
            set:html={GithubIcon}
          />
          Star on GitHub
        </a>
      </div>
    </div>

    <div
      class="reviu-reveal-right mx-auto mt-16 flex max-w-2xl sm:mt-24 lg:mt-0 lg:mr-0 lg:ml-10 lg:max-w-none lg:flex-none xl:ml-32"
      style="--reveal-delay: 500ms;"
    >
      <div class="max-w-3xl flex-none sm:max-w-5xl lg:max-w-none">
        <div
          class="-m-2 rounded-xl bg-gray-900/5 p-2 ring-1 ring-gray-900/10 ring-inset lg:-m-4 lg:rounded-2xl lg:p-4 dark:bg-white/2.5 dark:ring-white/10"
        >
          <ThemePicture
            sources={heroImage}
            alt="Reviu desktop interface preview"
            loading="eager"
            fetchpriority="high"
            class="w-full rounded-sm sm:rounded-[13px] shadow-xl ring-1 ring-gray-900/10 dark:shadow-2xl dark:ring-white/10"
          />
        </div>
      </div>
    </div>
  </div>
</section>
