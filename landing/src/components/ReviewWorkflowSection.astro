---
import BadgeCheckIcon from "@lucide/astro/icons/badge-check";
import BellIcon from "@lucide/astro/icons/bell";
import GitMergeIcon from "@lucide/astro/icons/git-merge";
import GitPullRequestArrowIcon from "@lucide/astro/icons/git-pull-request-arrow";
import ListFilterIcon from "@lucide/astro/icons/list-filter";
import MessageCircleReplyIcon from "@lucide/astro/icons/message-circle-reply";

const workflowSteps = [
  {
    title: "Start from your GitHub inbox",
    description:
      "Open notifications, unread work, repository groups, and saved pull request lists from the desktop app.",
    icon: BellIcon,
  },
  {
    title: "Filter the review queue",
    description:
      "Use labels, authors, assignees, reviewers, review state, draft state, base branch, and sorting to find the right PR.",
    icon: ListFilterIcon,
  },
  {
    title: "Review the full changeset",
    description:
      "Move through files, inline or split diffs, suggested-change blocks, images, Markdown, SVG, and surrounding local files.",
    icon: GitPullRequestArrowIcon,
  },
  {
    title: "Discuss and resolve threads",
    description:
      "Create inline comments, reply, edit, delete, react, upload images, use emoji autocomplete, and resolve conversations.",
    icon: MessageCircleReplyIcon,
  },
  {
    title: "Check merge readiness",
    description:
      "See conflicts, out-of-date state, skipped checks, required checks, provider images, and blocked merge conditions.",
    icon: BadgeCheckIcon,
  },
  {
    title: "Merge or jump back local",
    description:
      "Merge with GitHub methods, enable auto-merge when blocked, or switch the local repo to the pull request branch.",
    icon: GitMergeIcon,
  },
];
---

<section
  id="github-workflow"
  class="py-24 sm:py-32"
  data-reveal-root
  data-reveal-threshold="0.12"
>
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="reviu-reveal mx-auto max-w-3xl text-center">
      <h2 class="text-base/7 font-semibold text-primary">Reviu Pro Workflow</h2>
      <p
        class="mt-2 text-4xl font-semibold tracking-tight text-balance text-foreground sm:text-5xl"
      >
        One desktop loop for daily GitHub review work.
      </p>
      <p class="mt-6 text-lg/8 text-muted-foreground">
        Reviu Pro is built for the path from notification to review to merge,
        with local Git one click away when the branch needs hands-on work.
      </p>
    </div>

    <div class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        workflowSteps.map((step, index) => (
          <article
            class="reviu-reveal rounded-3xl border border-border bg-background p-6"
            style={`--reveal-delay: ${index * 90 + 150}ms;`}
          >
            <div class="inline-flex size-11 items-center justify-center rounded-2xl bg-primary/10 text-primary ring-1 ring-primary/15">
              <step.icon class="size-5" aria-hidden="true" />
            </div>
            <h3 class="mt-5 text-lg font-semibold text-foreground">
              {step.title}
            </h3>
            <p class="mt-3 text-sm/7 text-muted-foreground">
              {step.description}
            </p>
          </article>
        ))
      }
    </div>
  </div>
</section>
