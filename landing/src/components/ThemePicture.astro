---
import type { ThemeImageSources } from "../lib/themeImage";

interface Props {
  sources: ThemeImageSources;
  alt: string;
  class?: string;
  loading?: "eager" | "lazy";
  fetchpriority?: "high" | "auto";
}

const {
  sources,
  alt,
  class: className,
  loading = "lazy",
  fetchpriority = "auto",
} = Astro.props as Props;
---

<picture>
  <source
    media="(prefers-color-scheme: dark)"
    type="image/avif"
    srcset={sources.darkAvif}
  />
  <source
    media="(prefers-color-scheme: dark)"
    type="image/webp"
    srcset={sources.darkWebp}
  />
  <source media="(prefers-color-scheme: dark)" srcset={sources.darkFallback} />
  <source type="image/avif" srcset={sources.lightAvif} />
  <source type="image/webp" srcset={sources.lightWebp} />
  <img
    src={sources.lightFallback}
    width={sources.width}
    height={sources.height}
    alt={alt}
    loading={loading}
    fetchpriority={fetchpriority}
    decoding="async"
    class={className}
  />
</picture>
