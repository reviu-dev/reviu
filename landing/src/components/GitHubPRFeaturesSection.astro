---
import gitHubPrChangesDark from "../assets/app_screenshots/github_pr_changes_dark.png";
import gitHubPrChangesLight from "../assets/app_screenshots/github_pr_changes_light.png";
import GitMergeConflictIcon from "@lucide/astro/icons/git-merge-conflict";
import GitMergeIcon from "@lucide/astro/icons/git-merge";
import GitPullRequestArrowIcon from "@lucide/astro/icons/git-pull-request-arrow";
import { Image } from "astro:assets";
import MessageCircleReplyIcon from "@lucide/astro/icons/message-circle-reply";
import SearchCheckIcon from "@lucide/astro/icons/search-check";
import SparklesIcon from "@lucide/astro/icons/sparkles";

const features = [
  {
    name: "Review the full changeset",
    description:
      "Open pull request diffs in a desktop view with inline and split layouts.",
    icon: GitPullRequestArrowIcon,
  },
  {
    name: "Comment where the code changed",
    description:
      "Start a review comment from the diff and keep replies tied to the exact lines under discussion.",
    icon: MessageCircleReplyIcon,
  },
  {
    name: "AI brief before you dive in",
    description:
      "Bring your OpenAI or Anthropic key and get a Pro-only PR brief: summary, files to review first, risks, and blockers, with file links that jump straight into the diff.",
    icon: SparklesIcon,
  },
  {
    name: "Review and merge in one place",
    description:
      "Approve, request changes, convert draft, or merge without bouncing back to GitHub in the browser.",
    icon: GitMergeIcon,
  },
  {
    name: "Resolve conflicts in the Git page",
    description:
      "When a pull request hits merge conflicts, jump from the PR to the Git page, fix the branch locally, and keep moving.",
    icon: GitMergeConflictIcon,
  },
  {
    name: "Browse the full project from the PR",
    description:
      "When you're on the PR branch locally, toggle unchanged files to see the surrounding code - not just what changed.",
    icon: SearchCheckIcon,
  },
];
---

<section
  class="bg-background py-24 sm:py-32"
  data-reveal-root
  data-reveal-threshold="0.3"
>
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="reviu-reveal mx-auto max-w-2xl sm:text-center">
      <h2 class="text-base/7 font-semibold text-primary">Reviu Pro</h2>
      <p
        class="mt-2 text-4xl font-semibold tracking-tight text-pretty text-foreground sm:text-5xl sm:text-balance"
      >
        Desktop pull request review that stays in flow
      </p>
      <p class="mt-6 text-lg/8 text-muted-foreground">
        Open pull requests in Reviu to review changed files, comment inline,
        track checks, and merge when the branch is ready.
      </p>
    </div>
  </div>
  <div class="relative overflow-hidden pt-16">
    <div
      class="reviu-reveal mx-auto max-w-7xl px-6 lg:px-8"
      style="--reveal-delay: 150ms;"
    >
      <Image
        width="3020"
        height="1894"
        src={gitHubPrChangesLight}
        alt="Reviu pull request review screenshot in light mode"
        class="mb-[-12%] rounded-sm sm:rounded-xl shadow-2xl ring-1 ring-gray-900/10 dark:hidden"
      />
      <Image
        width="3020"
        height="1894"
        src={gitHubPrChangesDark}
        alt="Reviu pull request review screenshot in dark mode"
        class="mb-[-12%] rounded-sm sm:rounded-xl shadow-2xl ring-1 ring-white/10 not-dark:hidden"
      />
      <div aria-hidden="true" class="relative">
        <div
          class="absolute -inset-x-20 bottom-0 bg-linear-to-t from-background pt-[7%]"
        >
        </div>
      </div>
    </div>
  </div>
  <div class="mx-auto mt-16 max-w-7xl px-6 sm:mt-20 md:mt-24 lg:px-8">
    <dl
      class="mx-auto grid max-w-2xl grid-cols-1 gap-x-6 gap-y-10 text-base/7 text-muted-foreground sm:grid-cols-2 lg:mx-0 lg:max-w-none lg:grid-cols-3 lg:gap-x-8 lg:gap-y-16"
    >
      {
        features.map((feature, index) => {
          const Icon = feature.icon;

          return (
            <div
              class="reviu-reveal relative pl-9"
              style={`--reveal-delay: ${index * 80 + 200}ms;`}
            >
              <dt class="font-semibold text-foreground">
                <Icon
                  aria-hidden="true"
                  class="absolute top-1 left-1 size-5 text-primary"
                />
                {feature.name}
              </dt>
              <dd class="inline text-sm">{feature.description}</dd>
            </div>
          );
        })
      }
    </dl>
  </div>
</section>
