---
import CheckIcon from "@lucide/astro/icons/check";
import MinusIcon from "@lucide/astro/icons/minus";
import SparklesIcon from "@lucide/astro/icons/sparkles";

const downloadsSectionUrl = "#downloads";

const tiers = [
  {
    name: "Free",
    id: "free",
    href: downloadsSectionUrl,
    available: true,
    price: "$0",
    description:
      "Full local Git client for everyday development and review workflows.",
    features: [
      "Real-time diff editor with inline and split views",
      "Branch, merge, rebase, stash, cherry-pick, and conflict resolution",
      "Interactive rebase, squash, and edit commits",
      "Keyboard-first command palette and shortcuts",
    ],
    featured: false,
    cta: "Download app",
  },
  {
    name: "Pro",
    id: "pro",
    href: downloadsSectionUrl,
    available: true,
    annualPrice: "$79",
    annualPriceSuffix: "/year",
    monthlyPrice: "$9",
    monthlyPriceSuffix: "/month",
    savePercent: "Save 27%",
    description:
      "14-day free trial included. For developers who review pull requests every day.",
    features: [
      "GitHub notifications, saved PR lists, and repository sections",
      "Pull request reviews with inline comments and resolved threads",
      "AI features with your own OpenAI or Anthropic key",
      "Checks, merge readiness, merge actions, and auto-merge",
      "Issues, reactions, labels, assignees, and reviewers",
      "Browser extensions for GitHub repos, PRs, and issues",
    ],
    featured: true,
    cta: "Download & start free trial",
  },
];

const comparisonRows = [
  {
    feature: "Full local Git workflow",
    free: true,
    pro: true,
  },
  {
    feature: "Real-time diff editor",
    free: true,
    pro: true,
  },
  {
    feature: "Inline and split diff views",
    free: true,
    pro: true,
  },
  {
    feature: "Conflict resolution",
    free: true,
    pro: true,
  },
  {
    feature: "Merge, rebase, and interactive rebase",
    free: true,
    pro: true,
  },
  {
    feature: "GitHub notifications and desktop notification badges",
    free: false,
    pro: true,
  },
  {
    feature: "Review pull requests, comment inline, track checks, and merge",
    free: false,
    pro: true,
  },
  {
    feature: "Resolve review threads and apply suggested changes",
    free: false,
    pro: true,
  },
  {
    feature: "Move between your local branch and its pull request",
    free: false,
    pro: true,
  },
  {
    feature: "Saved pull request lists with filters",
    free: false,
    pro: true,
  },
  {
    feature: "Browse GitHub repositories, pull requests, and issues",
    free: false,
    pro: true,
  },
  {
    feature: "Open GitHub repos, pull requests, and issues from the browser",
    free: false,
    pro: true,
  },
  {
    feature: "AI features (bring your own OpenAI or Anthropic key)",
    free: false,
    pro: true,
  },
];
---

<section
  id="pricing"
  class="group/tiers py-24 sm:py-32"
  data-reveal-root
  data-reveal-threshold="0.05"
>
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="reviu-reveal mx-auto max-w-4xl text-center">
      <h2 class="text-base/7 font-semibold text-primary">Pricing</h2>
      <p
        class="mt-2 text-4xl font-semibold tracking-tight text-balance text-foreground sm:text-5xl"
      >
        Free for local Git. Pro for GitHub review workflows.
      </p>
      <p
        class="mx-auto mt-6 max-w-2xl text-center text-lg font-medium text-pretty text-gray-600 sm:text-xl/8 dark:text-gray-400"
      >
        Use Free for complete local Git workflows, then upgrade to Pro when GitHub becomes part of your daily review loop.
      </p>
    </div>

    <div
      class="isolate mx-auto mt-10 grid max-w-md grid-cols-1 gap-8 lg:mx-0 lg:max-w-none lg:grid-cols-2 lg:px-20 xl:px-40"
    >
      {
        tiers.map((tier, index) => (
          <div
            class="reviu-reveal group/tier rounded-3xl bg-background p-8 ring-1 ring-border data-featured:ring-primary xl:p-10 dark:data-featured:ring-2"
            data-featured={tier.featured ? "true" : undefined}
            style={`--reveal-delay: ${index * 150 + 200}ms;`}
          >
            <div class="flex items-center gap-2">
              <h3
                id={`tier-${tier.id}`}
                class="text-lg/8 font-semibold text-foreground group-data-featured/tier:text-primary"
              >
                {tier.name}
              </h3>
              {tier.featured && (
                <SparklesIcon class="size-4 text-primary" aria-hidden="true" />
              )}
            </div>
            <p class="mt-4 text-sm/6 text-muted-foreground">
              {tier.description}
            </p>
            {"annualPrice" in tier ? (
              <div class="mt-6 grid grid-cols-2 gap-3">
                <div class="flex flex-col gap-1 rounded-lg border border-primary/20 bg-primary/5 p-3">
                  <p class="text-xs font-semibold tracking-wide text-primary uppercase">Annual</p>
                  <div class="flex items-end gap-1">
                    <p class="text-3xl font-semibold tracking-tight text-foreground">
                      {tier.annualPrice}
                    </p>
                    <p class="pb-0.5 text-sm font-medium text-muted-foreground">
                      {tier.annualPriceSuffix}
                    </p>
                  </div>
                  <p class="text-xs font-medium text-primary">{tier.savePercent}</p>
                </div>
                <div class="flex flex-col gap-1 rounded-lg border border-border p-3">
                  <p class="text-xs font-semibold tracking-wide text-muted-foreground uppercase">Monthly</p>
                  <div class="flex items-end gap-1">
                    <p class="text-3xl font-semibold tracking-tight text-foreground">
                      {tier.monthlyPrice}
                    </p>
                    <p class="pb-0.5 text-sm font-medium text-muted-foreground">
                      {tier.monthlyPriceSuffix}
                    </p>
                  </div>
                </div>
              </div>
            ) : (
              <div class="mt-6 flex items-end gap-2">
                <p class="text-4xl font-semibold tracking-tight text-foreground">
                  {tier.price}
                </p>
              </div>
            )}

            {tier.available ? (
              <a
                href={tier.href}
                aria-describedby={`tier-${tier.id}`}
                data-umami-event={`see-downloads-pricing-${tier.id}`}
                class="reviu-hover-lift mt-6 block w-full rounded-md bg-primary px-3 py-2 text-center text-sm/6 font-semibold text-white shadow-xs transition-colors hover:bg-primary/80 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary group-data-featured/tier:focus-visible:outline-white/75 dark:shadow-none"
              >
                {tier.cta}
              </a>
            ) : (
              <div class="mt-6">
                <button
                  type="button"
                  disabled
                  class="block w-full cursor-not-allowed rounded-md bg-muted px-3 py-2 text-center text-sm/6 font-semibold text-muted-foreground"
                >
                  {tier.cta}
                </button>
              </div>
            )}

            <ul
              role="list"
              class="mt-8 space-y-3 text-sm/6 text-muted-foreground xl:mt-10"
            >
              {tier.features.map((feature) => (
                <li class="flex gap-x-3">
                  <CheckIcon
                    class="h-6 w-5 flex-none text-primary"
                    aria-hidden="true"
                  />
                  {feature}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div
      class="reviu-reveal mx-auto mt-16 max-w-5xl"
      style="--reveal-delay: 500ms;"
    >
      <div class="mx-auto max-w-3xl text-center">
        <h3 class="text-2xl font-semibold tracking-tight text-foreground">
          Compare Free and Pro
        </h3>
        <p class="mt-3 text-base text-muted-foreground sm:text-lg">
          Free covers the full local Git workflow. Pro keeps all of that and
          adds GitHub notifications, repository context, issue work, and pull
          request review.
        </p>
      </div>

      <div class="mt-8 overflow-hidden rounded-3xl border border-border">
        <div
          class="hidden grid-cols-[minmax(0,1fr)_8rem_8rem] gap-4 bg-muted/40 px-6 py-4 text-sm font-semibold text-foreground sm:grid"
        >
          <div>Feature</div>
          <div class="text-center">Free</div>
          <div class="text-center text-primary">Pro</div>
        </div>

        <div class="divide-y divide-border bg-background">
          {
            comparisonRows.map((row) => (
              <div class="grid gap-3 px-4 py-4 sm:grid-cols-[minmax(0,1fr)_8rem_8rem] sm:items-center sm:gap-4 sm:px-6">
                <div class="pr-4 text-sm font-medium text-foreground sm:text-base">
                  {row.feature}
                </div>

                <div class="flex items-center justify-between sm:justify-center">
                  <span class="text-xs font-semibold tracking-wide text-muted-foreground uppercase sm:hidden">
                    Free
                  </span>
                  <span
                    class:list={[
                      "inline-flex size-8 items-center justify-center rounded-full ring-1 ring-inset",
                      row.free
                        ? "bg-primary/10 text-primary ring-primary/15"
                        : "bg-muted text-muted-foreground ring-border",
                    ]}
                  >
                    {row.free ? (
                      <CheckIcon class="size-4" aria-hidden="true" />
                    ) : (
                      <MinusIcon class="size-4" aria-hidden="true" />
                    )}
                    <span class="sr-only">
                      {row.free ? "Included in Free" : "Not included in Free"}
                    </span>
                  </span>
                </div>

                <div class="flex items-center justify-between sm:justify-center">
                  <span class="text-xs font-semibold tracking-wide text-muted-foreground uppercase sm:hidden">
                    Pro
                  </span>
                  <span
                    class:list={[
                      "inline-flex size-8 items-center justify-center rounded-full ring-1 ring-inset",
                      row.pro
                        ? "bg-primary/10 text-primary ring-primary/15"
                        : "bg-muted text-muted-foreground ring-border",
                    ]}
                  >
                    {row.pro ? (
                      <CheckIcon class="size-4" aria-hidden="true" />
                    ) : (
                      <MinusIcon class="size-4" aria-hidden="true" />
                    )}
                    <span class="sr-only">
                      {row.pro ? "Included in Pro" : "Not included in Pro"}
                    </span>
                  </span>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <p
      class="reviu-reveal mx-auto mt-8 max-w-2xl text-center text-sm text-muted-foreground"
      style="--reveal-delay: 650ms;"
    >
      Start free, then move to Pro when you want GitHub built into the same
      workflow.
    </p>
  </div>
</section>
