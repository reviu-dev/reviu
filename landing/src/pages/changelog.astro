---
import Layout from "../layouts/Layout.astro";
import SiteFooter from "../components/SiteFooter.astro";
import TagIcon from "@lucide/astro/icons/tag";
import { marked } from "marked";
import { env } from "../lib/env";

interface ChangelogEntry {
  version: string;
  publishedAt: string;
  body: string;
}

const backendUrl = env.BACKEND_URL.replace(/\/$/, "");
const res = await fetch(`${backendUrl}/desktop/update/changelog`);

if (!res.ok) {
  throw new Error(`Failed to fetch changelog: ${res.status} ${res.statusText}`);
}

const entries: ChangelogEntry[] = await res.json();

function formatDate(iso: string): string {
  if (!iso) return "";
  const date = new Date(iso);
  return date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}

function renderMarkdown(md: string): string {
  return marked.parse(md, { async: false }) as string;
}
---

<Layout
  title="Changelog"
  description="See what's new in every Reviu release — features, fixes, and improvements."
  pathname="/changelog"
>
  <main class="py-20 sm:py-24">
    <section class="mx-auto max-w-3xl px-6 lg:px-8">
      <a
        href="/"
        class="inline-flex items-center rounded-md bg-background px-3 py-2 text-sm font-semibold text-foreground hover:bg-muted/50"
      >
        &larr; Back
      </a>

      <div class="mt-6" data-reveal-root data-reveal-threshold="0.05">
        <h1
          class="reviu-reveal text-4xl font-semibold tracking-tight text-foreground sm:text-5xl"
        >
          Changelog
        </h1>
        <p
          class="reviu-reveal mt-4 text-lg text-muted-foreground"
          style="--reveal-delay: 100ms;"
        >
          New features, fixes, and improvements in each release.
        </p>
      </div>

      {
        entries.length === 0 && (
          <div class="mt-12 rounded-lg border border-border bg-secondary p-6 text-center">
            <p class="text-sm text-muted-foreground">No releases yet.</p>
          </div>
        )
      }

      {
        entries.length > 0 && (
          <div class="mt-12 space-y-0">
            {entries.map((entry) => (
              <article
                class="group relative border-l-2 border-border pb-12 pl-8 last:pb-0"
              >
                <div class="absolute top-0 -left-[9px] flex size-4 items-center justify-center rounded-full border-2 border-primary bg-background" />

                <div class="flex flex-wrap items-center gap-3">
                  <span class="inline-flex items-center gap-1.5 rounded-full bg-primary/10 px-3 py-1 text-sm font-semibold text-primary ring-1 ring-primary/20 ring-inset">
                    <TagIcon class="size-3.5" aria-hidden="true" />
                    {entry.version}
                  </span>
                  {entry.publishedAt && (
                    <time
                      datetime={entry.publishedAt}
                      class="text-sm text-muted-foreground"
                    >
                      {formatDate(entry.publishedAt)}
                    </time>
                  )}
                </div>

                <div
                  class="changelog-body mt-4 text-sm/7 text-muted-foreground"
                  set:html={renderMarkdown(entry.body)}
                />
              </article>
            ))}
          </div>
        )
      }
    </section>
  </main>
  <SiteFooter />
</Layout>

<style is:global>
  .changelog-body h1,
  .changelog-body h2,
  .changelog-body h3 {
    color: var(--foreground);
    font-weight: 600;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .changelog-body h1 {
    font-size: 1.25rem;
  }

  .changelog-body h2 {
    font-size: 1.125rem;
  }

  .changelog-body h3 {
    font-size: 1rem;
  }

  .changelog-body p {
    margin-top: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .changelog-body ul,
  .changelog-body ol {
    margin-top: 0.5rem;
    margin-bottom: 0.5rem;
    padding-left: 1.5rem;
  }

  .changelog-body ul {
    list-style-type: disc;
  }

  .changelog-body ol {
    list-style-type: decimal;
  }

  .changelog-body li {
    margin-top: 0.25rem;
    margin-bottom: 0.25rem;
  }

  .changelog-body code {
    font-size: 0.85em;
    padding: 0.15em 0.4em;
    border-radius: 0.25rem;
    background-color: var(--secondary);
    color: var(--foreground);
  }

  .changelog-body pre {
    margin-top: 0.75rem;
    margin-bottom: 0.75rem;
    padding: 1rem;
    border-radius: 0.5rem;
    background-color: var(--secondary);
    overflow-x: auto;
  }

  .changelog-body pre code {
    padding: 0;
    background: none;
  }

  .changelog-body a {
    color: var(--primary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .changelog-body a:hover {
    opacity: 0.8;
  }

  .changelog-body blockquote {
    margin-top: 0.75rem;
    margin-bottom: 0.75rem;
    padding-left: 1rem;
    border-left: 3px solid var(--border);
    color: var(--muted-foreground);
  }

  .changelog-body hr {
    margin-top: 1.5rem;
    margin-bottom: 1.5rem;
    border-color: var(--border);
  }

  .changelog-body img {
    max-width: 100%;
    border-radius: 0.5rem;
    margin-top: 0.75rem;
    margin-bottom: 0.75rem;
  }
</style>
