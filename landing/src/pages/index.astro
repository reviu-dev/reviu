---
import HeroSection from "../components/HeroSection.astro";
import DownloadSection from "../components/DownloadSection.astro";
import GitHubHomeFeaturesSection from "../components/GitHubHomeFeaturesSection.astro";
import GitHubPRFeaturesSection from "../components/GitHubPRFeaturesSection.astro";
import GitFeaturesSection from "../components/GitFeaturesSection.astro";
import PricingSection from "../components/PricingSection.astro";
import BrowserExtensionsSection from "../components/BrowserExtensionsSection.astro";
import ReviewWorkflowSection from "../components/ReviewWorkflowSection.astro";
import SwitchToReviuSection from "../components/SwitchToReviuSection.astro";
import FaqSection from "../components/FaqSection.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Layout from "../layouts/Layout.astro";

const description =
  "Reviu is a native Rust desktop Git client for reviewing your AI agent's code before you push, with a built-in Claude and Codex agent panel, free local Git workflows, and GitHub notifications, repositories, issues, pull request review, and merge actions in Reviu Pro.";

const faqItems: { question: string; answer: string }[] = [
  {
    question: "What is Reviu?",
    answer:
      "Reviu is a native desktop Git client built with Rust and GPUI for reviewing your AI agent's code before you push. Use it free for local Git and the built-in Claude or Codex agent panel, or upgrade to Reviu Pro for GitHub notifications, repositories, issues, and pull request review in the same app.",
  },
  {
    question: "Can I review my agent's code inside Reviu?",
    answer:
      "Yes. Reviu has a built-in agent panel that runs Claude or Codex from the sidebar. Review the diff your agent produced, leave inline review comments on the lines you want changed, and send them back to the agent without copy-paste. The agent panel is free and works on local changes.",
  },
  {
    question: "Why use Reviu if I already use Fork, Tower, or GitKraken?",
    answer:
      "Reviu is built for the loop from agent diff to GitHub merge. Free covers local Git plus the built-in Claude or Codex agent panel. Pro adds saved pull request lists, notifications, issue context, inline review comments, checks, merge readiness, and browser-to-desktop shortcuts.",
  },
  {
    question: "How is Reviu different from GitHub Desktop?",
    answer:
      "GitHub Desktop is great for opening a pull request branch locally. Reviu Pro goes deeper into review work with inline comments, replies, resolved threads, checks, issue context, and merge actions inside the desktop app.",
  },
  {
    question: "Is Reviu built with a webview?",
    answer:
      'No. Reviu is a fully native desktop app built with <a href="https://gpui.rs" target="_blank" rel="noopener noreferrer" class="text-primary underline hover:text-primary/80">gpui.rs</a>, a Rust-based GPU-accelerated UI framework. No Electron, no webview - just native performance.',
  },
  {
    question: "Do I need an account to use Reviu?",
    answer:
      "No. All local Git features work without an account, signing in is only required for GitHub integration in Reviu Pro.",
  },
  {
    question: "Which platforms does Reviu support?",
    answer:
      "Reviu supports macOS (Apple Silicon and Intel), Windows (ARM64 and x64), and Linux through the install command on the download section.",
  },
];

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "Reviu",
    applicationCategory: "DeveloperApplication",
    operatingSystem: "macOS, Linux, Windows",
    url: "https://reviu.dev/",
    description,
    offers: [
      {
        "@type": "Offer",
        name: "Reviu Free",
        price: "0",
        priceCurrency: "USD",
      },
      {
        "@type": "Offer",
        name: "Reviu Pro Monthly",
        price: "9",
        priceCurrency: "USD",
      },
      {
        "@type": "Offer",
        name: "Reviu Pro Annual",
        price: "79",
        priceCurrency: "USD",
      },
    ],
    featureList: [
      "Native Rust GPU-accelerated desktop application",
      "Keyboard-first Git command palette",
      "Real-time diff editor",
      "Inline and split diff views",
      "AI agent panel with Claude and Codex",
      "Review-to-agent inline comments on local diffs",
      "GitHub notifications",
      "Saved GitHub pull request lists",
      "GitHub repository browsing",
      "GitHub pull request review",
      "GitHub pull request checks and merge actions",
      "GitHub issues context",
      "Browser extensions for GitHub repositories, pull requests, and issues",
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqItems.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.answer,
      },
    })),
  },
];
---

<Layout description={description} pathname="/" structuredData={structuredData}>
  <main>
    <HeroSection />
    <GitFeaturesSection />
    <ReviewWorkflowSection />
    <GitHubHomeFeaturesSection />
    <GitHubPRFeaturesSection />
    <SwitchToReviuSection />
    <PricingSection />
    <BrowserExtensionsSection />
    <DownloadSection />
    <FaqSection faqItems={faqItems} />
    <SiteFooter />
  </main>
</Layout>
