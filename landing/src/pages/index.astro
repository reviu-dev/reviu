---
import HeroSection from "../components/HeroSection.astro";
import DownloadSection from "../components/DownloadSection.astro";
import GitHubHomeFeaturesSection from "../components/GitHubHomeFeaturesSection.astro";
import GitHubPRFeaturesSection from "../components/GitHubPRFeaturesSection.astro";
import GitFeaturesSection from "../components/GitFeaturesSection.astro";
import PricingSection from "../components/PricingSection.astro";
import FaqSection from "../components/FaqSection.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Layout from "../layouts/Layout.astro";

const description =
  "Reviu is a desktop Git client with keyboard-first local workflows, fast diffs, and GitHub notifications, repos, pull request reviews, and issues in Reviu Pro.";

const faqItems: { question: string; answer: string }[] = [
  {
    question: "What is Reviu?",
    answer:
      "Reviu is a desktop Git client focused on fast review workflows, keyboard-first navigation, local diffs, and GitHub context in one app.",
  },
  {
    question: "Is Reviu built with a webview?",
    answer:
      'No. Reviu is a fully native desktop app built with <a href="https://gpui.rs" target="_blank" rel="noopener noreferrer" class="text-primary underline hover:text-primary/80">gpui.rs</a>, a Rust-based GPU-accelerated UI framework. No Electron, no webview - just native performance.',
  },
  {
    question: "Do I need an account to use Reviu?",
    answer:
      "No. All local Git features work without an account, signing in is only required for GitHub integration in Reviu Pro.",
  },
  {
    question: "Which platforms does Reviu support?",
    answer:
      "Reviu currently supports macOS on Apple Silicon and Intel, plus Linux through the install command on the download section. Windows support is planned.",
  },
];

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "Reviu",
    applicationCategory: "DeveloperApplication",
    operatingSystem: "macOS, Linux",
    url: "https://reviu.dev/",
    description,
    offers: [
      {
        "@type": "Offer",
        name: "Reviu Free",
        price: "0",
        priceCurrency: "USD",
      },
      {
        "@type": "Offer",
        name: "Reviu Pro",
        price: "19",
        priceCurrency: "USD",
      },
    ],
    featureList: [
      "Keyboard-first Git command palette",
      "Advanced local Git operations",
      "Inline and split diff review",
      "GitHub notifications",
      "GitHub repository browsing",
      "GitHub pull request review",
      "GitHub issues context",
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqItems.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.answer,
      },
    })),
  },
];
---

<Layout description={description} pathname="/" structuredData={structuredData}>
  <main>
    <HeroSection />
    <GitFeaturesSection />
    <GitHubHomeFeaturesSection />
    <GitHubPRFeaturesSection />
    <PricingSection />
    <DownloadSection />
    <FaqSection faqItems={faqItems} />
    <SiteFooter />
  </main>
</Layout>
