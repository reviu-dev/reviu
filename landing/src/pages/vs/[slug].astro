---
import Layout from "../../layouts/Layout.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import CheckIcon from "@lucide/astro/icons/check";
import DownloadIcon from "@lucide/astro/icons/download";
import {
  comparisons,
  comparisonRows,
  reviuColumn,
  getComparisonUrl,
} from "../../lib/comparisons";

export function getStaticPaths() {
  return comparisons.map((comparison) => ({
    params: { slug: comparison.slug },
    props: { comparison },
  }));
}

const { comparison } = Astro.props;
const site = Astro.site ?? new URL("https://reviu.dev");
const pageUrl = new URL(getComparisonUrl(comparison.slug), site).toString();

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: comparison.faq.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: { "@type": "Answer", text: item.answer },
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Home",
        item: site.toString(),
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Compare",
        item: new URL("/vs", site).toString(),
      },
      {
        "@type": "ListItem",
        position: 3,
        name: `Reviu vs ${comparison.name}`,
        item: pageUrl,
      },
    ],
  },
];
---

<Layout
  title={comparison.title}
  description={comparison.metaDescription}
  pathname={getComparisonUrl(comparison.slug)}
  structuredData={structuredData}
>
  <main class="py-20 sm:py-24">
    <article class="mx-auto max-w-5xl px-6 lg:px-8">
      <a
        href="/vs"
        class="inline-flex items-center rounded-md bg-background px-3 py-2 text-sm font-semibold text-foreground hover:bg-muted/50"
      >
        &larr; Compare
      </a>

      <header class="mt-6" data-reveal-root data-reveal-threshold="0.05">
        <h1
          class="reviu-reveal text-4xl font-semibold tracking-tight text-foreground sm:text-5xl"
        >
          Reviu vs {comparison.name}
        </h1>
        {
          comparison.intro.map((paragraph, index) => (
            <p
              class="reviu-reveal mt-5 text-lg/8 text-muted-foreground"
              style={`--reveal-delay: ${index * 80 + 80}ms;`}
            >
              {paragraph}
            </p>
          ))
        }
      </header>

      <section class="mt-14" data-reveal-root data-reveal-threshold="0.05">
        <h2
          class="reviu-reveal text-2xl font-semibold tracking-tight text-foreground"
        >
          How Reviu and {comparison.name} compare
        </h2>
        <div class="reviu-reveal mt-6 overflow-x-auto" style="--reveal-delay: 80ms;">
          <table class="w-full min-w-2xl border-collapse text-left text-sm">
            <thead>
              <tr class="border-b border-border">
                <th class="py-3 pr-4 font-semibold text-muted-foreground"></th>
                <th class="py-3 pr-4 font-semibold text-primary">Reviu</th>
                <th class="py-3 font-semibold text-foreground"
                  >{comparison.name}</th
                >
              </tr>
            </thead>
            <tbody>
              {
                comparisonRows.map((row) => (
                  <tr class="border-b border-border align-top">
                    <th class="py-3 pr-4 text-left font-medium text-foreground">
                      {row.label}
                    </th>
                    <td class="py-3 pr-4 text-muted-foreground">
                      {reviuColumn[row.id]}
                    </td>
                    <td class="py-3 text-muted-foreground">
                      {comparison.columns[row.id]}
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </section>

      <div class="mt-14 grid gap-6 sm:grid-cols-2">
        <section
          class="rounded-2xl border border-border bg-background p-6"
          data-reveal-root
          data-reveal-threshold="0.05"
        >
          <h2
            class="reviu-reveal text-xl font-semibold tracking-tight text-foreground"
          >
            When {comparison.name} is the better choice
          </h2>
          <ul class="reviu-reveal mt-4 space-y-3" style="--reveal-delay: 80ms;">
            {
              comparison.whenCompetitor.map((point) => (
                <li class="flex gap-2 text-sm/7 text-muted-foreground">
                  <CheckIcon
                    class="mt-1 size-4 shrink-0 text-muted-foreground"
                    aria-hidden="true"
                  />
                  {point}
                </li>
              ))
            }
          </ul>
        </section>

        <section
          class="rounded-2xl border border-primary/30 bg-primary/5 p-6"
          data-reveal-root
          data-reveal-threshold="0.05"
        >
          <h2
            class="reviu-reveal text-xl font-semibold tracking-tight text-foreground"
          >
            When Reviu fits better
          </h2>
          <ul class="reviu-reveal mt-4 space-y-3" style="--reveal-delay: 80ms;">
            {
              comparison.whenReviu.map((point) => (
                <li class="flex gap-2 text-sm/7 text-muted-foreground">
                  <CheckIcon
                    class="mt-1 size-4 shrink-0 text-primary"
                    aria-hidden="true"
                  />
                  {point}
                </li>
              ))
            }
          </ul>
        </section>
      </div>

      <section class="mt-16" data-reveal-root data-reveal-threshold="0.05">
        <h2
          class="reviu-reveal text-2xl font-semibold tracking-tight text-foreground"
        >
          Frequently asked questions
        </h2>
        <dl class="reviu-reveal mt-6 space-y-6" style="--reveal-delay: 80ms;">
          {
            comparison.faq.map((item) => (
              <div class="border-b border-border pb-6 last:border-b-0">
                <dt class="text-base font-semibold text-foreground">
                  {item.question}
                </dt>
                <dd class="mt-2 text-sm/7 text-muted-foreground">
                  {item.answer}
                </dd>
              </div>
            ))
          }
        </dl>
      </section>

      <section
        class="mt-14 border-t border-border pt-8"
        data-reveal-root
        data-reveal-threshold="0.05"
      >
        <h2 class="reviu-reveal text-2xl font-semibold tracking-tight text-foreground">
          Try Reviu
        </h2>
        <p
          class="reviu-reveal mt-3 text-base/7 text-muted-foreground"
          style="--reveal-delay: 60ms;"
        >
          Use Reviu free for local Git and the agent panel, then start Reviu Pro
          for GitHub pull request review, notifications, issues, and merge in the
          desktop app.
        </p>
        <a
          href="/#downloads"
          data-umami-event={`download-vs-${comparison.slug}`}
          class="reviu-reveal reviu-hover-lift mt-5 inline-flex items-center gap-2 rounded-md bg-primary px-3.5 py-2.5 text-sm font-semibold text-white shadow-xs transition-colors hover:bg-primary/80 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
          style="--reveal-delay: 120ms;"
        >
          <DownloadIcon class="size-4" aria-hidden="true" />
          Download now
        </a>
      </section>
    </article>
  </main>
  <SiteFooter />
</Layout>
