---
import Layout from "../layouts/Layout.astro";

const lastUpdated = "March 4, 2026";
---

<Layout>
  <main class="py-20 sm:py-24">
    <section class="mx-auto max-w-4xl px-6 lg:px-8">
      <a
        href="/"
        class="inline-flex items-center rounded-md bg-background px-3 py-2 text-sm font-semibold text-foreground hover:bg-muted/50"
      >
        ← Back
      </a>
      <h1
        class="mt-6 text-4xl font-semibold tracking-tight text-foreground sm:text-5xl"
      >
        Legal Notice
      </h1>
      <p class="mt-4 text-sm/6 text-muted-foreground">
        Last updated: {lastUpdated}
      </p>
      <p class="mt-6 text-base/7 text-muted-foreground">
        This page provides publisher and hosting information for the Reviu
        landing site and related services.
      </p>

      <h2 class="mt-12 text-2xl font-semibold text-foreground">
        Publisher Information
      </h2>
      <ul class="mt-4 space-y-3 text-sm/7 text-muted-foreground">
        <li>
          <span class="font-medium text-foreground">Legal entity:</span>
          <code>{"{{LEGAL_ENTITY_NAME}}"}</code>
        </li>
        <li>
          <span class="font-medium text-foreground">Legal form:</span>
          <code>{"{{LEGAL_ENTITY_FORM}}"}</code>
        </li>
        <li>
          <span class="font-medium text-foreground">Registered address:</span>
          <code>{"{{REGISTERED_ADDRESS}}"}</code>
        </li>
        <li>
          <span class="font-medium text-foreground">Registration number:</span>
          <code>{"{{REGISTRATION_NUMBER}}"}</code>
        </li>
        <li>
          <span class="font-medium text-foreground">VAT number:</span>
          <code>{"{{VAT_NUMBER}}"}</code>
        </li>
      </ul>

      <h2 class="mt-10 text-2xl font-semibold text-foreground">Contact</h2>
      <p class="mt-4 text-sm/7 text-muted-foreground">
        For legal notices and formal communication: <code
          >{"{{LEGAL_CONTACT_EMAIL}}"}</code
        >
      </p>

      <h2 class="mt-10 text-2xl font-semibold text-foreground">
        Hosting Provider
      </h2>
      <p class="mt-4 text-sm/7 text-muted-foreground">
        Reviu is hosted on infrastructure provided by Hetzner Online GmbH.
      </p>
      <p class="mt-2 text-sm/7 text-muted-foreground">
        Hetzner Online GmbH, Industriestr. 25, 91710 Gunzenhausen, Germany.
      </p>

      <h2 class="mt-10 text-2xl font-semibold text-foreground">
        Intellectual Property
      </h2>
      <p class="mt-4 text-sm/7 text-muted-foreground">
        Unless otherwise stated, all content on this site is owned by Reviu and
        protected by applicable intellectual property laws.
      </p>

      <h2 class="mt-10 text-2xl font-semibold text-foreground">Liability</h2>
      <p class="mt-4 text-sm/7 text-muted-foreground">
        Reviu takes reasonable care in preparing information on this site, but
        does not guarantee that all content is complete, accurate, or current at
        all times.
      </p>
    </section>
  </main>
</Layout>
